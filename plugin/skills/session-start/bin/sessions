#!/usr/bin/env bash
# List sessions from each session.md frontmatter. Optional status filter.
#
#   bin/sessions            # all sessions, newest id first
#   bin/sessions active     # only status: active
#   bin/sessions closed     # only status: closed
#
# Sessions live at $TERMINAL_SESSIONS_DIR/NNNN-slug/session.md in v2 and
# any pre-migration copies still in the repo. Portable (macOS+Linux).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
want_status="${1:-}"

# field <file> <key> -> first frontmatter value for key (quotes stripped)
field() {
  awk -v key="$2" '
    NR==1 && $0=="---" { infm=1; next }
    infm && $0=="---"  { exit }
    infm && $0 ~ "^"key": " {
      sub("^"key": *",""); gsub(/^"|"$/,""); print; exit
    }' "$1"
}

printf '%-6s %-9s %-12s %s\n' ID STATUS STARTED TITLE
printf '%-6s %-9s %-12s %s\n' "----" "------" "-------" "-----"

shopt -s nullglob 2>/dev/null || true
found=""
# Every root this repo reads from — the sidecar plus anything not migrated yet
# — resolved in one place rather than hardcoded here. Newest first.
read_dirs=()
while IFS= read -r d; do
  [ -n "$d" ] && read_dirs+=("$d/[0-9]*/")
done < <("$(dirname "$0")/../../../bin/tm-state-dirs" sessions 2>/dev/null || true)
[ ${#read_dirs[@]} -gt 0 ] || read_dirs=("/nonexistent/[0-9]*/")
# Deliberately unquoted: these entries are globs, and quoting them stops the
# shell expanding them — which silently lists nothing at all.
for d in $(ls -1d ${read_dirs[@]} 2>/dev/null | sort -r); do
  f="$d/session.md"
  [ -e "$f" ] || continue
  found=1
  status="$(field "$f" status)"
  [ -n "$want_status" ] && [ "$status" != "$want_status" ] && continue
  started="$(field "$f" started)"
  printf '%-6s %-9s %-12s %s\n' \
    "$(field "$f" id)" "$status" "${started%%T*}" "$(field "$f" title)"
done
[ -n "$found" ] || echo "(no sessions yet — start one with /session-start)" >&2
