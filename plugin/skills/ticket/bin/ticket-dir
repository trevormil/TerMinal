#!/usr/bin/env bash
# Resolve the absolute directory NEW tickets are written to, then print it.
#
# Order of resolution:
#   1. $OBSIDIAN_TICKETS_DIR — set by TerMinal in a session whose repo uses the
#      Obsidian ticket provider (tickets live in an external vault, not the repo).
#   2. the provider config tickets.json (sidecar first, legacy in-repo copy as
#      fallback) with provider "obsidian" — parse the vault path
#      (works outside a TerMinal session too).
#   3. The per-project sidecar, via $TERMINAL_BACKLOG_DIR / tm-state-dir.
#
# There is deliberately NO "legacy v1 repo" branch. One used to sit at step 3:
# if the repo had a `backlog/` and no v2 marker, tickets were written back into
# the checkout. EVERY repo predating the sidecar matches that condition, so on
# the most-used repos the migration was a no-op — the shell kept filing into
# git while the app filed the same tickets into the sidecar, from two separate
# id counters. Pre-migration tickets stay READABLE via tm-state-dirs; they are
# simply never written to again.
#
# Keeping this in one place means every ticket op (allocate id, write, list)
# targets the same store, so an Obsidian repo never scatters tickets into git.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# 1. TerMinal-injected env (fast path).
if [ -n "${OBSIDIAN_TICKETS_DIR:-}" ]; then
  printf '%s\n' "$OBSIDIAN_TICKETS_DIR"
  exit 0
fi

# 2. Obsidian provider config on disk — sidecar copy first (where the app
#    writes it now), legacy in-repo copy as fallback. # state-path-ok
CFG="$("$(dirname "$0")/../../../bin/tm-state-dir" tickets.json 2>/dev/null || true)"
[ -n "$CFG" ] && [ -f "$CFG" ] || CFG="$ROOT/.TerMinal/tickets.json" # state-path-ok: read-only legacy fallback
if [ -f "$CFG" ] && grep -q '"provider"[[:space:]]*:[[:space:]]*"obsidian"' "$CFG"; then
  vault="$(grep -o '"vaultPath"[[:space:]]*:[[:space:]]*"[^"]*"' "$CFG" | head -1 | sed 's/.*:[[:space:]]*"//; s/"$//')"
  sub="$(grep -o '"ticketsSubdir"[[:space:]]*:[[:space:]]*"[^"]*"' "$CFG" | head -1 | sed 's/.*:[[:space:]]*"//; s/"$//')"
  [ -n "$sub" ] || sub="tickets"
  if [ -n "$vault" ]; then
    printf '%s/%s\n' "$vault" "$sub"
    exit 0
  fi
fi

# 3. The sidecar. Unconditional — see the header. A resolver failure (not
# inside a git repo, resolver missing) must NOT print an empty line with exit
# 0 — a caller doing `dir=$(ticket-dir)` would then write to "/" or cwd.
dir="${TERMINAL_BACKLOG_DIR:-$("$(dirname "$0")/../../../bin/tm-state-dir" backlog 2>/dev/null || true)}"
[ -n "$dir" ] || { echo "ticket-dir: could not resolve the backlog dir (not in a git repo?)" >&2; exit 1; }
printf '%s\n' "$dir"
