#!/usr/bin/env bash
# Print the active forge for this repo: "github" or "gitlab".
#
# Resolution order:
#   1. $FORGE env var (explicit, per-invocation)
#   2. sidecar `forge` file (THE per-repo override — required for self-hosted
#      GitLab; write with: echo gitlab > "$(tm-state-dir forge)")
#   3. .claude/forge file (legacy in-repo override — no longer seeded, still honored)
#   4. auto-detect from origin remote (*github* -> github; *gitlab* -> gitlab)
#   5. default: github
#
#   forge="$(forge)"   # tm plugin bin
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if [ -n "${FORGE:-}" ]; then
  case "$FORGE" in github|gitlab) echo "$FORGE"; exit 0 ;; esac
fi

# Sidecar override: resolve through tm-state-dir so the path logic stays
# single-source. Resolve $0 through symlinks first — a linked/copied forge
# must still find the real sibling. Best-effort: missing resolver falls through.
self="$0"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
resolver="$(cd "$(dirname "$self")" && pwd)/tm-state-dir"
[ -x "$resolver" ] || resolver="$(command -v tm-state-dir || echo "")"
sidecar_forge=""
[ -n "$resolver" ] && sidecar_forge="$("$resolver" forge 2>/dev/null || echo "")"
if [ -n "$sidecar_forge" ] && [ -f "$sidecar_forge" ]; then
  val="$(tr -d '[:space:]' < "$sidecar_forge")"
  case "$val" in github|gitlab) echo "$val"; exit 0 ;; esac
fi

if [ -f "$ROOT/.claude/forge" ]; then
  val="$(tr -d '[:space:]' < "$ROOT/.claude/forge")"
  case "$val" in github|gitlab) echo "$val"; exit 0 ;; esac
fi

url="$(git -C "$ROOT" remote get-url origin 2>/dev/null || echo "")"
case "$url" in
  *gitlab*) echo gitlab ;;
  *github*) echo github ;;
  # No origin at all (a repo never pushed anywhere) stays github — the common
  # case for a fresh local repo about to get a GitHub remote.
  "")       echo github ;;
  # An origin on an unrecognized host is most likely self-hosted: glab speaks
  # to arbitrary instances, gh only to GitHub — same default as the app's
  # forgeKindForHost. Override via the sidecar file when wrong.
  *)        echo gitlab ;;
esac
