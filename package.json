{
  "name": "terminal",
  "productName": "TerMinal",
  "version": "0.2.0",
  "description": "A standalone, local-first software factory for coding agents: hosts the real Claude Code / Codex CLI with a live cockpit, autonomous build loop, scheduling, and cross-repo observability \u2014 no server, no account.",
  "author": "Trevor Miller",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevormil/TerMinal.git"
  },
  "homepage": "https://github.com/trevormil/TerMinal#readme",
  "bugs": "https://github.com/trevormil/TerMinal/issues",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "release": "bin/release",
    "cut-release": "bun bin/cut-release",
    "test": "bun test",
    "test:effects": "bun scripts/effect-canary.ts",
    "test:ux": "playwright test",
    "test:ux:headed": "HEADED=1 playwright test",
    "ux:taste": "bun scripts/ux-taste.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:baseline": "eslint . --suppress-all",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild": "electron-rebuild -f -o node-pty,better-sqlite3",
    "postinstall": "electron-rebuild -f -o node-pty,better-sqlite3",
    "shots": "bun scripts/capture-readme-shots.ts"
  },
  "dependencies": {
    "@codemirror/language": "6.12.3",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.0",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@uiw/codemirror-extensions-langs": "4.25.11",
    "@uiw/react-codemirror": "4.25.11",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.11.0",
    "better-sqlite3": "13.0.2",
    "highlight.js": "11.11.1",
    "lucide-react": "1.16.0",
    "mermaid": "11.16.0",
    "node-pty": "1.1.0",
    "parse-diff": "0.12.0",
    "qrcode-generator": "2.0.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.14",
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.6",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6"
  },
  "overrides": {
    "app-builder-lib": "26.15.6",
    "brace-expansion": "5.0.9",
    "builder-util-runtime": "9.7.0",
    "fast-uri": "3.1.5",
    "postcss": "8.5.22",
    "undici": "7.29.0"
  }
}
