# Personal workflow state — tickets, sessions, reviews, checks and reports now
# live in a per-project sidecar outside the repo. These entries cover repos that
# still carry theirs in-tree (Settings → Updates → Project state moves them), so
# nothing new lands in a repo shared with collaborators.
.TerMinal/backlog/
.TerMinal/sessions/
.TerMinal/reviews/
.TerMinal/checks/
.TerMinal/reports/
.TerMinal/notes.md

# Legacy v1 layout, same reason
/backlog/
/sessions/
/.reviews/
/.checks/
/reports/

# Live status snapshot — ephemeral, regenerated by the tm plugin's bin/status (committed
# session docs are the durable state; .status.md is the human-facing glance)
.status.md

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Dependencies / build
node_modules/
dist/
build/
.venv/

# OS / editor cruft
.DS_Store
*.log

