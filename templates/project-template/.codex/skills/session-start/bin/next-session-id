#!/usr/bin/env bash
# Atomically allocate the next session ID.
#
# Portable: uses a mkdir-based lock (works on macOS + Linux; no `flock`).
# Bootstraps the sessions directory and counter on first use, so dropping the
# session-start/session-end skills into a fresh repo "just works".
#
#   id=$("$HOME/.config/TerMinal/plugin/skills/session-start/bin/next-session-id")
#   mkdir -p "$SESSIONS_REL/${id}-my-slug"
#
# v2 repos use $TERMINAL_SESSIONS_DIR/.next-id; legacy v1 repos use sessions/.next-id.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# The sidecar path is ABSOLUTE; only the legacy in-repo dir is relative to
# $ROOT. Joining them would put the sidecar under the repo.
if [ -d "$ROOT/sessions" ] && [ ! -f "$ROOT/.TerMinal/template.json" ]; then
  SESSIONS="$ROOT/sessions"
else
  SESSIONS="${TERMINAL_SESSIONS_DIR:-$("$HOME/.config/TerMinal/plugin/bin/tm-state-dir" sessions)}"
fi
COUNTER="$SESSIONS/.next-id"
LOCK="$SESSIONS/.next-id.lock"

mkdir -p "$SESSIONS"
# Seed the counter from the highest id that already exists ANYWHERE this repo
# reads from — a fresh sidecar has no counter, and the repo may still hold
# 0001-0042, so starting at 1 would duplicate and shadow them.
if [ ! -f "$COUNTER" ]; then
  highest=0
  for d in "$SESSIONS" "$ROOT/.TerMinal/sessions" "$ROOT/sessions"; do  # state-path-ok: scans the pre-migration locations so ids never collide
    [ -d "$d" ] || continue
    for e in "$d"/[0-9][0-9][0-9][0-9]-*; do
      [ -e "$e" ] || continue
      n="$(basename "$e" | cut -c1-4)"
      case "$n" in [0-9][0-9][0-9][0-9]) [ "$((10#$n))" -gt "$highest" ] && highest="$((10#$n))" ;; esac
    done
  done
  printf '%s\n' "$((highest + 1))" > "$COUNTER"
fi

acquired=""
for _ in $(seq 1 50); do
  if mkdir "$LOCK" 2>/dev/null; then
    acquired=1
    trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
    break
  fi
  sleep 0.1
done
[ -n "$acquired" ] || { echo "ERROR: could not acquire lock $LOCK" >&2; exit 1; }

current="$(tr -d '[:space:]' < "$COUNTER")"
printf '%04d\n' "$current"
printf '%s\n' "$((current + 1))" > "$COUNTER"
