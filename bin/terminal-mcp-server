// src/runner/state-io.ts
import {
  closeSync,
  mkdirSync,
  openSync,
  readFileSync as readFileSync3,
  renameSync,
  unlinkSync,
  writeFileSync
} from "fs";
import { dirname } from "path";
import { randomUUID } from "crypto";
function writeJsonAtomicShared(file, value) {
  mkdirSync(dirname(file), { recursive: true });
  const tmp = `${file}.${process.pid}.tmp`;
  try {
    writeFileSync(tmp, `${JSON.stringify(value, null, 2)}
`);
    renameSync(tmp, file);
  } catch (e) {
    try {
      unlinkSync(tmp);
    } catch {}
    throw e;
  }
}
function sleepSyncShared(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}
function readLockShared(lockPath) {
  try {
    const p = JSON.parse(readFileSync3(lockPath, "utf8"));
    return typeof p?.token === "string" ? p : null;
  } catch {
    return null;
  }
}
function pidAliveShared(pid) {
  if (!Number.isInteger(pid) || pid <= 0)
    return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (e) {
    return e?.code === "EPERM";
  }
}
function withFileLockShared(file, fn, { timeoutMs = 5000, staleMs = 30000 } = {}) {
  const lockPath = `${file}.lock`;
  const token = randomUUID();
  mkdirSync(dirname(file), { recursive: true });
  const deadline = Date.now() + timeoutMs;
  for (;; ) {
    let took = false;
    try {
      const fd = openSync(lockPath, "wx");
      try {
        writeFileSync(fd, JSON.stringify({ pid: process.pid, at: Date.now(), token }));
      } finally {
        closeSync(fd);
      }
      sleepSyncShared(2);
      took = readLockShared(lockPath)?.token === token;
    } catch {}
    if (took)
      break;
    const held = readLockShared(lockPath);
    if (held === null || !pidAliveShared(held.pid) || Date.now() - held.at > staleMs || Date.now() > deadline) {
      try {
        unlinkSync(lockPath);
      } catch {}
      continue;
    }
    sleepSyncShared(10);
  }
  try {
    return fn();
  } finally {
    if (readLockShared(lockPath)?.token === token) {
      try {
        unlinkSync(lockPath);
      } catch {}
    }
  }
}

// src/shared/inbox-store.ts
function inboxPaths(cfgDir) {
  return {
    hot: join6(cfgDir, "hitl.json"),
    archive: join6(cfgDir, "hitl-archive.jsonl"),
    counts: join6(cfgDir, "hitl-counts.json"),
    hidden: join6(cfgDir, "hitl-archive-hidden.json")
  };
}
function inboxPathsFor(hotFile) {
  return inboxPaths(hotFile.replace(/\/?hitl\.json$/, ""));
}
var INBOX_COUNTS_VERSION = 2;
var EMPTY_COUNTS = {
  version: 0,
  live: 0,
  unread: 0,
  archived: 0,
  byCategory: {},
  updatedAt: 0
};
function isInboxLive(h) {
  return !h.readAt && h.status !== "resolved";
}
var CATEGORY_FALLBACK = "Uncategorized";
function emptyCategoryCount() {
  return { live: 0, unread: 0, archived: 0, total: 0 };
}
function inboxCountsOf(live, archive) {
  const byCategory = Object.create(null);
  let unread = 0;
  for (const h of live) {
    const cat = h.category || CATEGORY_FALLBACK;
    const slot = byCategory[cat] ??= emptyCategoryCount();
    slot.live++;
    slot.total++;
    if (!h.readAt) {
      slot.unread++;
      unread++;
    }
  }
  for (const [cat, archived] of Object.entries(archive.byCategory)) {
    const slot = byCategory[cat] ??= emptyCategoryCount();
    slot.archived += archived;
    slot.total += archived;
  }
  return {
    version: INBOX_COUNTS_VERSION,
    live: live.length,
    unread,
    archived: archive.total,
    byCategory,
    updatedAt: Date.now()
  };
}
function readJsonArray(file) {
  let raw;
  try {
    raw = readFileSync4(file, "utf8");
  } catch {
    return "absent";
  }
  if (raw.trim() === "")
    return "absent";
  try {
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed : "corrupt";
  } catch {
    return "corrupt";
  }
}
function readHidden(file) {
  try {
    const parsed = JSON.parse(readFileSync4(file, "utf8"));
    return new Set(Array.isArray(parsed?.ids) ? parsed.ids.filter((i) => typeof i === "string") : []);
  } catch {
    return new Set;
  }
}
function readInboxCounts(p) {
  try {
    const parsed = JSON.parse(readFileSync4(p.counts, "utf8"));
    if (typeof parsed?.live !== "number" || typeof parsed?.archived !== "number")
      return { ...EMPTY_COUNTS };
    const byCategory = Object.create(null);
    for (const [cat, raw] of Object.entries(parsed.byCategory ?? {})) {
      const slot = raw;
      const live = typeof slot.live === "number" ? slot.live : 0;
      const unread = typeof slot.unread === "number" ? slot.unread : 0;
      const archived = typeof slot.archived === "number" ? slot.archived : 0;
      byCategory[cat] = { live, unread, archived, total: live + archived };
    }
    return { ...EMPTY_COUNTS, ...parsed, byCategory };
  } catch {
    return { ...EMPTY_COUNTS };
  }
}
var BLOCK = 64 * 1024;
function readLinesBackward(file, end, want) {
  if (end <= 0 || want <= 0)
    return { lines: [], offset: Math.max(0, end) };
  const fd = openSync2(file, "r");
  try {
    let start = end;
    let region = Buffer.alloc(0);
    for (;; ) {
      const size = Math.min(BLOCK, start);
      if (size > 0) {
        const block = Buffer.alloc(size);
        readSync(fd, block, 0, size, start - size);
        start -= size;
        region = Buffer.concat([block, region]);
      }
      const parts = splitLines(region);
      const complete = parts.slice(start > 0 ? 1 : 0, -1);
      if (complete.length >= want || start === 0) {
        const kept = complete.slice(Math.max(0, complete.length - want));
        let bytes = 0;
        for (const line of kept)
          bytes += line.length + 1;
        return { lines: kept.map((b) => b.toString("utf8")), offset: end - bytes };
      }
    }
  } finally {
    closeSync2(fd);
  }
}
function splitLines(region) {
  const out = [];
  let from = 0;
  for (;; ) {
    const nl = region.indexOf(10, from);
    if (nl < 0)
      break;
    out.push(region.subarray(from, nl));
    from = nl + 1;
  }
  out.push(region.subarray(from));
  return out;
}
function readInboxArchive(p, opts = {}) {
  const limit = Math.max(1, Math.min(500, opts.limit ?? 50));
  let size;
  try {
    size = statSync(p.archive).size;
  } catch {
    return { items: [], cursor: null, done: true };
  }
  const parsedCursor = opts.cursor == null ? size : Number(opts.cursor);
  let end = Number.isFinite(parsedCursor) ? Math.min(Math.max(0, parsedCursor), size) : size;
  if (end <= 0)
    return { items: [], cursor: null, done: true };
  const hidden = readHidden(p.hidden);
  const liveIds = new Set(readHotRaw(p.hot).filter(isInboxLive).map((h) => h.id));
  const seen = new Set;
  const items = [];
  while (end > 0 && items.length < limit) {
    const need = limit - items.length;
    const { lines, offset } = readLinesBackward(p.archive, end, need);
    if (!lines.length) {
      end = offset;
      break;
    }
    for (let i = lines.length - 1;i >= 0; i--) {
      let rec;
      try {
        rec = JSON.parse(lines[i]);
      } catch {
        continue;
      }
      if (!rec?.id || seen.has(rec.id))
        continue;
      seen.add(rec.id);
      if (hidden.has(rec.id) || liveIds.has(rec.id))
        continue;
      items.push(rec);
    }
    end = offset;
  }
  return { items, cursor: end > 0 ? String(end) : null, done: end <= 0 };
}
function readHotRaw(file) {
  const raw = readJsonArray(file);
  return Array.isArray(raw) ? raw : [];
}

class InboxCorruptError extends Error {
  file;
  quarantinedTo;
  constructor(file, quarantinedTo) {
    super(`Refusing to write corrupt inbox state ${file}` + (quarantinedTo ? `; moved aside to ${quarantinedTo}` : ""));
    this.file = file;
    this.quarantinedTo = quarantinedTo;
    this.name = "InboxCorruptError";
  }
}
function findArchived(p, ids) {
  const out = new Map;
  if (!ids.length)
    return out;
  const wanted = new Set(ids);
  let cursor = undefined;
  for (let page = 0;page < 400 && wanted.size; page++) {
    const res = readInboxArchive(p, { cursor, limit: 500 });
    for (const item of res.items)
      if (wanted.has(item.id)) {
        out.set(item.id, item);
        wanted.delete(item.id);
      }
    if (res.done)
      break;
    cursor = res.cursor;
  }
  return out;
}
function updateInbox(p, fn, opts = {}) {
  return withFileLockShared(p.hot, () => {
    importLegacyDailyArchives(p);
    const raw = readJsonArray(p.hot);
    if (raw === "corrupt") {
      const dest = `${p.hot}.corrupt-${Date.now()}`;
      renameSync2(p.hot, dest);
      throw new InboxCorruptError(p.hot, dest);
    }
    const hot = raw === "absent" ? [] : raw;
    const live = hot.filter(isInboxLive);
    const strays = hot.filter((h) => !isInboxLive(h));
    const includeIds = (opts.include ?? []).filter((id) => !live.some((h) => h.id === id));
    const pulled = findArchived(p, includeIds);
    const working = [...live, ...pulled.values()];
    const before = new Map(working.map((h) => [h.id, h]));
    const next = fn(working);
    if (next === undefined) {
      if (!strays.length)
        return false;
      return commit(p, live, strays, [], readInboxCounts(p), new Map);
    }
    const nextLive = [];
    const retiring = [];
    for (const h of next)
      (isInboxLive(h) ? nextLive : retiring).push(h);
    const toArchive = [
      ...strays,
      ...retiring.filter((h) => {
        const prior = pulled.get(h.id);
        return !prior || JSON.stringify(prior) !== JSON.stringify(h);
      })
    ];
    const nextIds = new Set(next.map((h) => h.id));
    const dropped = [...before.keys()].filter((id) => !nextIds.has(id));
    return commit(p, nextLive, toArchive, dropped, readInboxCounts(p), pulled);
  });
}
function commit(p, live, toArchive, dropped, prev, previouslyArchived) {
  const archive = prev.version === INBOX_COUNTS_VERSION ? {
    total: prev.archived,
    byCategory: Object.fromEntries(Object.entries(prev.byCategory).filter(([, slot]) => slot.archived > 0).map(([cat, slot]) => [cat, slot.archived]))
  } : summarizeArchive(p, new Set(live.map((item) => item.id)));
  const adjustArchiveCategory = (item, delta) => {
    const cat = item.category || CATEGORY_FALLBACK;
    archive.byCategory[cat] = Math.max(0, (archive.byCategory[cat] ?? 0) + delta);
    if (!archive.byCategory[cat])
      delete archive.byCategory[cat];
  };
  for (const item of toArchive) {
    const prior = previouslyArchived.get(item.id);
    if (prior) {
      adjustArchiveCategory(prior, -1);
    } else {
      archive.total++;
    }
    adjustArchiveCategory(item, 1);
  }
  const liveIds = new Set(live.map((item) => item.id));
  const rearchivedIds = new Set(toArchive.map((item) => item.id));
  for (const [id, prior] of previouslyArchived) {
    if (!liveIds.has(id) || rearchivedIds.has(id))
      continue;
    archive.total = Math.max(0, archive.total - 1);
    adjustArchiveCategory(prior, -1);
  }
  for (const id of dropped) {
    const prior = previouslyArchived.get(id);
    if (!prior)
      continue;
    archive.total = Math.max(0, archive.total - 1);
    adjustArchiveCategory(prior, -1);
  }
  if (toArchive.length)
    appendFileSync(p.archive, toArchive.map((h) => `${JSON.stringify(h)}
`).join(""));
  if (dropped.length) {
    const hidden = readHidden(p.hidden);
    for (const id of dropped)
      hidden.add(id);
    writeJsonAtomicShared(p.hidden, { ids: [...hidden] });
  }
  writeJsonAtomicShared(p.hot, live);
  writeJsonAtomicShared(p.counts, inboxCountsOf(live, archive));
  return true;
}
function importLegacyDailyArchives(p) {
  const dir = p.archive.replace(/\.jsonl$/, "");
  let names;
  try {
    names = readdirSync3(dir).filter((n) => n.endsWith(".json")).sort();
  } catch {
    return;
  }
  const lines = [];
  for (const name of names) {
    const parsed = readJsonArray(join6(dir, name));
    if (!Array.isArray(parsed))
      continue;
    for (const item of parsed)
      if (item?.id)
        lines.push(`${JSON.stringify(item)}
`);
  }
  if (lines.length)
    appendFileSync(p.archive, lines.join(""));
  try {
    renameSync2(dir, `${dir}.imported-${Date.now()}`);
  } catch {}
}
function summarizeArchive(p, liveIds) {
  try {
    const hidden = readHidden(p.hidden);
    const records = new Map;
    for (const line of readFileSync4(p.archive, "utf8").split(`
`)) {
      if (!line.trim())
        continue;
      try {
        const item = JSON.parse(line);
        if (item.id && !hidden.has(item.id) && !liveIds.has(item.id))
          records.set(item.id, item);
      } catch {}
    }
    const byCategory = Object.create(null);
    for (const item of records.values()) {
      const cat = item.category || CATEGORY_FALLBACK;
      byCategory[cat] = (byCategory[cat] ?? 0) + 1;
    }
    return { total: records.size, byCategory };
  } catch {
    return { total: 0, byCategory: {} };
  }
}
function readInboxLive(p) {
  const raw = readJsonArray(p.hot);
  if (raw === "corrupt")
    throw new InboxCorruptError(p.hot);
  const hot = raw === "absent" ? [] : raw;
  if (hot.every(isInboxLive))
    return hot;
  updateInbox(p, () => {
    return;
  });
  const after = readJsonArray(p.hot);
  return Array.isArray(after) ? after : hot.filter(isInboxLive);
}
function inboxCounts(p) {
  const stored = readInboxCounts(p);
  if (stored.version === INBOX_COUNTS_VERSION)
    return stored;
  updateInbox(p, (live) => live);
  return readInboxCounts(p);
}

// src/shared/activity-log.ts
import { closeSync as closeSync3, existsSync as existsSync4, openSync as openSync3, readSync as readSync2, renameSync as renameSync3, rmSync, statSync as statSync2 } from "fs";
import { basename as basename3, dirname as dirname2, join as join7 } from "path";
var BLOCK2 = 64 * 1024;
var ACTIVITY_ROTATE_BYTES = 5 * 1024 * 1024;
var ACTIVITY_GENERATIONS = 2;
function activityGenerationPaths(base) {
  const dir = dirname2(base);
  const name = basename3(base);
  const dot = name.lastIndexOf(".");
  const stem = dot > 0 ? name.slice(0, dot) : name;
  const ext = dot > 0 ? name.slice(dot) : "";
  const out = [base];
  for (let i = 1;i <= ACTIVITY_GENERATIONS; i++)
    out.push(join7(dir, `${stem}-${i}${ext}`));
  return out;
}
function parse(line) {
  if (!line.trim())
    return null;
  try {
    const ev = JSON.parse(line);
    return ev && typeof ev === "object" ? ev : null;
  } catch {
    return null;
  }
}
function readRange(fd, start, len) {
  if (len <= 0)
    return Buffer.alloc(0);
  const buf = Buffer.alloc(len);
  let got = 0;
  while (got < len) {
    const n = readSync2(fd, buf, got, len - got, start + got);
    if (n <= 0)
      break;
    got += n;
  }
  return got === len ? buf : buf.subarray(0, got);
}
function lastLineEnd(fd, end) {
  let pos = end;
  while (pos > 0) {
    const start = Math.max(0, pos - BLOCK2);
    const buf = readRange(fd, start, pos - start);
    const idx = buf.lastIndexOf(10);
    if (idx >= 0)
      return start + idx + 1;
    pos = start;
  }
  return 0;
}
function* reverseLinesInFile(file, end) {
  let fd;
  try {
    fd = openSync3(file, "r");
  } catch {
    return;
  }
  try {
    let pos = lastLineEnd(fd, end);
    let carry = Buffer.alloc(0);
    while (pos > 0) {
      const start = Math.max(0, pos - BLOCK2);
      const buf = Buffer.concat([readRange(fd, start, pos - start), carry]);
      pos = start;
      carry = Buffer.alloc(0);
      let cut = buf.length;
      while (cut > 0) {
        const nl = cut >= 2 ? buf.lastIndexOf(10, cut - 2) : -1;
        if (nl >= 0) {
          yield { line: buf.subarray(nl + 1, cut - 1).toString("utf8"), start: start + nl + 1 };
          cut = nl + 1;
        } else if (start === 0) {
          yield { line: buf.subarray(0, cut - 1).toString("utf8"), start: 0 };
          cut = 0;
        } else {
          carry = buf.subarray(0, cut);
          break;
        }
      }
    }
  } finally {
    closeSync3(fd);
  }
}
function* reverseLines(base, cursor) {
  const paths = activityGenerationPaths(base);
  const from = cursor ? cursor.gen : 0;
  for (let gen = from;gen < paths.length; gen++) {
    const file = paths[gen];
    if (!existsSync4(file))
      continue;
    let end = 0;
    if (gen === from && cursor)
      end = cursor.offset;
    else {
      try {
        end = statSync2(file).size;
      } catch {
        continue;
      }
    }
    for (const l of reverseLinesInFile(file, end))
      yield { gen, start: l.start, line: l.line };
  }
}
function readActivityPage(base, opts = {}) {
  const limit = Math.max(1, opts.limit ?? 200);
  const maxScan = opts.maxScan ?? Math.max(limit * 50, 5000);
  const events = [];
  let cursor = null;
  let consumed = null;
  let scanned = 0;
  for (const { gen, start, line } of reverseLines(base, opts.cursor)) {
    if (events.length >= limit || scanned >= maxScan) {
      cursor = consumed;
      break;
    }
    scanned++;
    consumed = { gen, offset: start };
    const ev = parse(line);
    if (ev && (!opts.filter || opts.filter(ev)))
      events.push(ev);
  }
  return { events, cursor };
}

// src/mcp/notify.ts
import { spawn } from "child_process";
import { existsSync as existsSync5, readFileSync as readFileSync5 } from "fs";
function slackCfg() {
  try {
    const c = JSON.parse(readFileSync5(SLACK_SIDECAR(), "utf8"));
    return typeof c?.botToken === "string" && c.botToken ? c : null;
  } catch {
    return null;
  }
}
function slackQuietsTelegram() {
  return slackCfg()?.destination === "slack";
}
function slackSlug(raw) {
  return String(raw || "").toLowerCase().replace(/[/\s]+/g, "-").replace(/[^a-z0-9_-]+/g, "").replace(/-+/g, "-").replace(/^-|-$/g, "");
}
function slackChannelFor(category, cfg) {
  const fallback = slackSlug(cfg.defaultChannel).slice(0, 80) || "terminal-inbox";
  const slug = category && category !== "Uncategorized" ? slackSlug(category) : "";
  if (!slug)
    return fallback;
  const prefix = slackSlug(cfg.channelPrefix);
  return (prefix ? `${prefix}-${slug}` : slug).slice(0, 80);
}
function slackApi(token, method, body) {
  return fetch(`https://slack.com/api/${method}`, {
    method: "POST",
    headers: {
      authorization: `Bearer ${token}`,
      "content-type": "application/json; charset=utf-8"
    },
    body: JSON.stringify(body),
    signal: AbortSignal.timeout(8000)
  }).then((r) => r.json());
}
var pendingEffects = new Set;
function trackEffect(promise) {
  pendingEffects.add(promise);
  promise.catch(() => {}).finally(() => pendingEffects.delete(promise));
  return promise;
}
function mirrorHitlToSlack(item, hitlFile) {
  const cfg = slackCfg();
  if (!cfg)
    return;
  trackEffect((async () => {
    const channel = slackChannelFor(item.category, cfg);
    const fallback = slackChannelFor(undefined, cfg);
    const marker = item.source === "completion-hook" ? "\u2705" : "\u26D4";
    const text = `${marker} ${item.title}${item.action ? ` \u2014 ${item.action}` : ""}`;
    const post = (to) => slackApi(cfg.botToken, "chat.postMessage", { channel: to, text });
    let res = await post(`#${channel}`);
    if (!res?.ok && res?.error === "channel_not_found" && cfg.autoCreateChannels) {
      const created = await slackApi(cfg.botToken, "conversations.create", { name: channel });
      if (created?.ok && created.channel?.id) {
        if (cfg.inviteUserId)
          await slackApi(cfg.botToken, "conversations.invite", {
            channel: created.channel.id,
            users: cfg.inviteUserId
          }).catch(() => {});
        res = await post(created.channel.id);
      }
    }
    if (!res?.ok && channel !== fallback)
      res = await post(`#${fallback}`);
    if (res?.ok && typeof res.channel === "string" && typeof res.ts === "string") {
      updateInbox(inboxPathsFor(hitlFile), (live) => live.map((h) => h.id === item.id ? { ...h, slackChannel: res.channel, slackTs: res.ts } : h));
    }
  })().catch(() => {}));
}
function tgCreds() {
  const pick = (o) => {
    const bt = o?.botToken;
    const ci = o?.chatId;
    return typeof bt === "string" && bt && typeof ci === "string" && ci ? { botToken: bt, chatId: ci } : null;
  };
  let sc = null;
  try {
    sc = JSON.parse(readFileSync5(TG_SIDECAR(), "utf8"));
  } catch {}
  return pick(sc) ?? pick(readSettings()?.telegram);
}
function pingTelegram(text, inlineKeyboard) {
  const telegram = tgCreds();
  if (telegram) {
    fetch(`https://api.telegram.org/bot${telegram.botToken}/sendMessage`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        chat_id: telegram.chatId,
        text,
        ...inlineKeyboard ? { reply_markup: { inline_keyboard: inlineKeyboard } } : {}
      }),
      signal: AbortSignal.timeout(8000)
    }).catch(() => {});
    return;
  }
  if (existsSync5(LEGACY_TG_SCRIPT())) {
    try {
      const child = spawn(LEGACY_TG_SCRIPT(), ["--kind=blocked", text], { stdio: "ignore" });
      child.on("error", () => {});
      child.unref();
    } catch {}
  }
}

// src/mcp/reads.ts
import { existsSync as existsSync6, readFileSync as readFileSync6, readdirSync as readdirSync4, statSync as statSync3 } from "fs";
import { basename as basename4, join as join8 } from "path";
function listTicketsForRoot(repoRoot, filter, includeBody) {
  const out = [];
  for (const dir of backlogReadDirs(repoRoot)) {
    let files;
    try {
      files = readdirSync4(dir);
    } catch {
      continue;
    }
    for (const f of files) {
      if (!/^\d{4}-.*\.md$/.test(f))
        continue;
      let raw;
      try {
        raw = readFileSync6(join8(dir, f), "utf8");
      } catch {
        continue;
      }
      const { meta, body } = parseFrontmatter(raw);
      const slug = f.replace(/\.md$/, "");
      const runId = String(meta.agent_run_id || "").trim();
      const ticket = {
        slug,
        id: typeof meta.id === "number" ? meta.id : parseInt(slug.slice(0, 4), 10),
        title: meta.title || slug,
        status: meta.status || "open",
        priority: meta.priority || "medium",
        type: meta.type || "feature",
        horizon: meta.horizon || "now",
        hitl: meta.hitl === true,
        created: meta.created,
        updated: meta.updated,
        prs: meta.prs || [],
        agent: ticketAgentFromMeta(meta),
        run: runId ? {
          id: runId,
          source: meta.agent_run_source || "agent",
          sessionId: meta.agent_session_id || undefined,
          startedAt: meta.agent_run_started_at || undefined,
          status: meta.agent_run_status || undefined
        } : undefined,
        repo: basename4(repoRoot)
      };
      if (includeBody)
        ticket.body = body.slice(0, 600);
      if (filter?.excludeClosed && ticket.status === "closed")
        continue;
      if (filter?.status && ticket.status !== filter.status)
        continue;
      if (filter?.type && ticket.type !== filter.type)
        continue;
      out.push(ticket);
    }
  }
  return out.sort((a, b) => a.id - b.id);
}
function listTicketsTool(args) {
  const repo = args.repo;
  const roots = repo ? [findRepoRoot(repo)].filter(Boolean) : knownRepoRoots();
  const statusArg = args.status;
  const filter = {
    type: args.type,
    status: statusArg && statusArg !== "all" ? statusArg : undefined,
    excludeClosed: !statusArg
  };
  const all = roots.flatMap((r) => listTicketsForRoot(r, filter, args.include_body === true));
  return typeof args.limit === "number" && args.limit > 0 ? all.slice(0, args.limit) : all;
}
function getTicketTool(args) {
  const slug = args.slug;
  if (!slug)
    return null;
  for (const root of knownRepoRoots()) {
    const f = backlogReadDirs(root).map((dir) => join8(dir, `${slug}.md`)).find((p) => existsSync6(p));
    if (f) {
      const raw = readFileSync6(f, "utf8");
      const { meta, body } = parseFrontmatter(raw);
      return {
        slug,
        repo: basename4(root),
        repoRoot: root,
        ...meta,
        body
      };
    }
  }
  return null;
}
function listPrs(args) {
  const root = prsRoot();
  if (!root || !existsSync6(root))
    return [];
  const out = [];
  const walk = (dir, depth = 0) => {
    if (depth > 4)
      return;
    let names;
    try {
      names = readdirSync4(dir);
    } catch {
      return;
    }
    for (const name of names) {
      const p = join8(dir, name);
      let st;
      try {
        st = statSync3(p);
      } catch {
        continue;
      }
      if (st.isDirectory())
        walk(p, depth + 1);
      else if (name === "meta.json") {
        try {
          const meta = JSON.parse(readFileSync6(p, "utf8"));
          if (args.repo && !meta.repo?.toLowerCase().includes(args.repo.toLowerCase()))
            continue;
          if (args.status && meta.state !== args.status)
            continue;
          out.push({
            host: meta.host,
            repo: meta.repo,
            number: meta.number,
            title: meta.title,
            state: meta.state,
            webUrl: meta.webUrl,
            author: meta.author,
            updatedAt: meta.updatedAt,
            commits: (meta.commits || []).length
          });
        } catch {}
      }
    }
  };
  walk(root);
  return out.sort((a, b) => String(b.updatedAt).localeCompare(String(a.updatedAt))).slice(0, 50);
}
function getPrArtifact(args) {
  const { host, repo, number, sha } = args;
  if (!host || !repo || !number)
    return null;
  const root = prsRoot();
  if (!root)
    return null;
  const dir = join8(root, host, ...repo.split("/"), String(number));
  if (!existsSync6(dir))
    return null;
  let targetSha = sha;
  if (!targetSha) {
    try {
      const meta2 = JSON.parse(readFileSync6(join8(dir, "meta.json"), "utf8"));
      targetSha = meta2.commits?.[0]?.slice(0, 7);
    } catch {}
  }
  if (!targetSha)
    return null;
  const file = join8(dir, `${targetSha}.md`);
  if (!existsSync6(file))
    return null;
  const raw = readFileSync6(file, "utf8");
  const { meta, body } = parseFrontmatter(raw);
  return { host, repo, number, sha: targetSha, meta, body };
}
function listSchedules(args) {
  const sf = join8(CFG(), "schedules.json");
  if (!existsSync6(sf))
    return [];
  try {
    const arr = JSON.parse(readFileSync6(sf, "utf8"));
    return arr.filter((s) => !args.repo || s.repoLabel?.toLowerCase().includes(args.repo.toLowerCase())).map((s) => ({
      id: s.id,
      agentId: s.agentId,
      agentTitle: s.agentTitle,
      repoLabel: s.repoLabel,
      spec: s.spec,
      engine: s.engine,
      enabled: s.enabled,
      lastStatus: s.lastStatus,
      lastRun: s.lastRun,
      promptPreview: typeof s.prompt === "string" ? s.prompt.slice(0, 120) : undefined
    }));
  } catch {
    return [];
  }
}
function recentAgentRuns(args) {
  const out = [];
  const cronDir = join8(CFG(), "cron-runs");
  if (existsSync6(cronDir)) {
    try {
      for (const f of readdirSync4(cronDir)) {
        if (!f.endsWith(".json"))
          continue;
        try {
          const r = JSON.parse(readFileSync6(join8(cronDir, f), "utf8"));
          if (args.repo && !r.repoLabel?.toLowerCase().includes(args.repo.toLowerCase()))
            continue;
          if (args.status && r.status !== args.status)
            continue;
          out.push({
            id: r.id,
            agentId: r.agentId,
            agentTitle: r.agentTitle,
            repoLabel: r.repoLabel,
            branch: r.branch,
            status: r.status,
            startedAt: r.startedAt,
            endedAt: r.endedAt,
            engine: r.engine,
            scheduleId: r.scheduleId,
            error: typeof r.error === "string" ? r.error.slice(0, 200) : r.error,
            source: "cron"
          });
        } catch {}
      }
    } catch {}
  }
  return out.sort((a, b) => (b.startedAt || 0) - (a.startedAt || 0)).slice(0, args.limit || 50);
}
function aiSpendToday(args) {
  const dir = join8(CFG(), "ai-runs");
  if (!existsSync6(dir))
    return { totalUsd: 0, totalRuns: 0, byModel: {}, byAgent: {} };
  const dayStart = (() => {
    const d = new Date;
    d.setHours(0, 0, 0, 0);
    return d.getTime();
  })();
  let totalUsd = 0;
  let totalRuns = 0;
  const byModel = {};
  const byAgent = {};
  try {
    for (const f of readdirSync4(dir)) {
      if (!f.endsWith(".json"))
        continue;
      try {
        const r = JSON.parse(readFileSync6(join8(dir, f), "utf8"));
        if ((r.startedAt || 0) < dayStart)
          continue;
        if (args.repo) {
          const b = basename4(r.repoRoot || "");
          if (!b.toLowerCase().includes(args.repo.toLowerCase()))
            continue;
        }
        if (args.agent && r.agentId !== args.agent)
          continue;
        totalUsd += r.costUsd || 0;
        totalRuns++;
        byModel[r.model] = (byModel[r.model] || 0) + (r.costUsd || 0);
        if (r.agentId)
          byAgent[r.agentId] = (byAgent[r.agentId] || 0) + (r.costUsd || 0);
      } catch {}
    }
  } catch {}
  return { totalUsd, totalRuns, byModel, byAgent };
}

// src/mcp/writes.ts
function fileTicket(args) {
  const {
    repo,
    title,
    body = "",
    type = "feature",
    priority = "medium",
    status = "open",
    source = "mcp",
    modelTier = "auto"
  } = args;
  if (!title)
    throw new Error("title is required");
  const repoRoot = findRepoRoot(repo);
  if (!repoRoot)
    throw new Error(`no repo matching "${repo}"`);
  const ticketConfig = readTicketConfig(repoRoot);
  if (ticketConfig.provider === "linear") {
    const team = ticketConfig.linear?.team;
    const teamKey = ticketConfig.linear?.teamKey;
    const teamLabel = team && teamKey ? `${team} (${teamKey})` : team || teamKey || "not selected";
    const issueExample = teamKey ? `${teamKey}-11` : "TEAM-123";
    throw new Error(`Linear ticket provider is active for bound team ${teamLabel}. Use the configured Linear MCP with an issue identifier such as ${issueExample}; TerMinal file_ticket only writes local markdown and is disabled for this repo.`);
  }
  if (ticketConfig.provider === "github")
    throw new Error("GitHub Issues is this repo's ticket provider. Use the gh CLI; TerMinal file_ticket only writes local markdown and is disabled for this repo.");
  if (ticketConfig.provider === "webview")
    throw new Error("This repo uses a ticket webview with no local ticket store. File the issue in the embedded provider page.");
  const backlogDir = backlogWriteDir(repoRoot);
  mkdirSync2(backlogDir, { recursive: true });
  const nextIdFile = join9(backlogDir, ".next-id");
  let nextId = 1;
  if (existsSync7(nextIdFile)) {
    try {
      nextId = parseInt(readFileSync7(nextIdFile, "utf8").trim(), 10) || 1;
    } catch {}
  }
  const highest = maxAreaId(backlogReadDirs(repoRoot).concat(backlogDir));
  nextId = Math.max(nextId, highest + 1);
  const id = String(nextId).padStart(4, "0");
  const slug = `${id}-${slugify(title)}`;
  const today = todayStr();
  const recommendation = recommendTicketAgent({ title, type, body });
  const agent = normalizeTicketAgent(args, type, recommendation);
  const frontmatter = `---
id: ${nextId}
title: ${JSON.stringify(title)}
status: ${status}
priority: ${priority}
horizon: now
hitl: false
type: ${type}
source: ${source}
created: ${today}
updated: ${today}
prs: []
refs: []
depends_on: []
model_tier: ${normalizeModelTier(modelTier)}
agent_id: ${agent.id}
agent_scope: ${agent.scope}
agent_kind: ${agent.kind}
---

${body}
`;
  const path = join9(backlogDir, `${slug}.md`);
  writeFileSync2(path, frontmatter);
  try {
    writeFileSync2(nextIdFile, String(nextId + 1) + `
`);
  } catch {}
  emitActivityRaw({
    kind: "ticket-filed",
    title: `Ticket filed \xB7 #${id}`,
    detail: title,
    repo: basename5(repoRoot),
    repoRoot
  });
  return { slug, id, path };
}
function locateTicket(slug) {
  let path = null;
  let repoRoot = null;
  for (const root of knownRepoRoots()) {
    const p = backlogReadDirs(root).map((dir) => join9(dir, `${slug}.md`)).find((candidate) => existsSync7(candidate));
    if (p) {
      path = p;
      repoRoot = root;
      break;
    }
  }
  return path ? { path, repoRoot } : null;
}
function commentTicket(args) {
  const { slug } = args;
  if (!slug)
    throw new Error("slug is required");
  const body = String(args.body || "").trim();
  if (!body)
    throw new Error("body is required and cannot be empty");
  const located = locateTicket(slug);
  if (!located)
    throw new Error(`ticket ${slug} not found in any known repo`);
  const raw = readFileSync7(located.path, "utf8");
  const m = raw.match(/^(---\n[\s\S]*?\n---\n?)([\s\S]*)$/);
  if (!m)
    throw new Error(`malformed frontmatter in ${located.path}`);
  const via = String(args.via || "").trim();
  const header = `### ${new Date().toISOString()} \xB7 agent:${String(args.author || "agent").trim()}${via ? ` (${via})` : ""}`;
  const prose = m[2].trim();
  const head = m[1].replace(/^(updated:[ \t]*).*$/m, `$1${todayStr()}`);
  const next = /^## Log$/m.test(m[2]) ? `${head}
${prose}

${header}
${body}
` : `${head}
${prose ? `${prose}

` : ""}## Log

${header}
${body}
`;
  writeFileSync2(located.path, next);
  return { ok: true, slug, path: located.path, repoRoot: located.repoRoot };
}
function updateTicket(args) {
  const { slug, status, priority, appendPrUrl, removePrUrl } = args;
  if (!slug)
    throw new Error("slug is required");
  const located = locateTicket(slug);
  if (!located)
    throw new Error(`ticket ${slug} not found in any known repo`);
  const { path, repoRoot } = located;
  const raw = readFileSync7(path, "utf8");
  const m = raw.match(/^(---\n[\s\S]*?\n---)([\s\S]*)$/);
  if (!m)
    throw new Error(`malformed frontmatter in ${path}`);
  let fm = m[1];
  const currentStatus = (fm.match(/^status:\s*(.*)$/m)?.[1] || "").trim();
  const currentTitle = (fm.match(/^title:\s*(.*)$/m)?.[1] || slug).trim().replace(/^["']|["']$/g, "");
  const ticketLabel = (fm.match(/^id:\s*(\d+)/m)?.[1] || slug).trim();
  const setField = (key, val) => {
    const re = new RegExp(`^(${key}:[ \\t]*).*$`, "m");
    if (re.test(fm))
      fm = fm.replace(re, `$1${val}`);
    else
      fm = fm.replace(/\n---$/, `
${key}: ${val}
---`);
  };
  if (status)
    setField("status", status);
  if (priority)
    setField("priority", priority);
  if (args.modelTier)
    setField("model_tier", normalizeModelTier(args.modelTier));
  if (Array.isArray(args.related))
    setField("related", `[${args.related.join(", ")}]`);
  if (args.duplicateOf !== undefined)
    setField("duplicate_of", Number(args.duplicateOf) > 0 ? String(args.duplicateOf) : "");
  if (args.agentId || args.agentScope || args.agentKind) {
    const agent = normalizeTicketAgent(args, (fm.match(/^type:\s*(.*)$/m)?.[1] || "feature").trim());
    setField("agent_id", agent.id);
    setField("agent_scope", agent.scope);
    setField("agent_kind", agent.kind);
  }
  if (args.runId) {
    setField("agent_run_id", args.runId);
    setField("agent_run_source", args.runSource || "agent");
    if (args.sessionId)
      setField("agent_session_id", args.sessionId);
    if (args.runStartedAt)
      setField("agent_run_started_at", args.runStartedAt);
    if (args.runStatus)
      setField("agent_run_status", args.runStatus);
  }
  setField("updated", todayStr());
  if (appendPrUrl || removePrUrl) {
    const prsMatch = fm.match(/^prs:\s*(.*)$/m);
    let prs = [];
    if (prsMatch) {
      const rawPrs = prsMatch[1].trim();
      if (rawPrs.startsWith("[") && rawPrs.endsWith("]")) {
        prs = rawPrs.slice(1, -1).split(",").map((s) => s.trim().replace(/^["']|["']$/g, "")).filter(Boolean);
      }
    }
    if (appendPrUrl && !prs.includes(appendPrUrl))
      prs.push(appendPrUrl);
    if (removePrUrl)
      prs = prs.filter((p) => p !== removePrUrl);
    const formatted = `[${prs.map((p) => JSON.stringify(p)).join(", ")}]`;
    if (prsMatch)
      fm = fm.replace(/^prs:\s*.*$/m, `prs: ${formatted}`);
    else
      fm = fm.replace(/\n---$/, `
prs: ${formatted}
---`);
  }
  writeFileSync2(path, fm + m[2]);
  if (status) {
    const unblocked = currentStatus === "stuck" && status !== "stuck";
    emitActivityRaw({
      kind: status === "closed" ? "ticket-closed" : "info",
      title: unblocked ? `Ticket unblocked \xB7 #${ticketLabel}` : `Ticket ${status} \xB7 #${ticketLabel}`,
      detail: unblocked ? `${currentTitle} \xB7 ${status}` : currentTitle,
      repo: basename5(repoRoot),
      repoRoot
    });
  }
  return { ok: true, path };
}
function updateTicketAgent(args) {
  const { slug } = args;
  if (!slug)
    throw new Error("slug is required");
  if (!args.agentId)
    throw new Error("agentId is required");
  return updateTicket(args);
}
function updateTicketRun(args) {
  if (!args.slug)
    throw new Error("slug is required");
  if (!args.runId)
    throw new Error("runId is required");
  return updateTicket(args);
}
function normalizeCategoryShared(raw) {
  if (typeof raw !== "string")
    return;
  const clean = raw.replace(/[\x00-\x1f\x7f]/g, "").trim();
  return clean ? clean.slice(0, 40) : undefined;
}
function fileHitlTool(args) {
  const {
    title,
    action,
    detail,
    repo,
    source = "agent",
    runId,
    ticketPath,
    severity,
    category
  } = args;
  if (!title)
    throw new Error("title is required");
  mkdirSync2(CFG(), { recursive: true });
  const hitlFile = HITL_FILE();
  const item = {
    id: randomUUID2(),
    title,
    action,
    detail,
    repo,
    source,
    status: "open",
    createdAt: Date.now(),
    ...normalizeCategoryShared(category) ? { category: normalizeCategoryShared(category) } : {},
    ...severity === "urgent" || severity === "normal" || severity === "low" ? { severity } : {},
    runId,
    ticketPath,
    sessionId: process.env.GT_TERMINAL_SESSION_ID || undefined,
    terminalKey: process.env.GT_TERMINAL_SESSION_KEY || undefined,
    terminalCwd: process.env.GT_TERMINAL_CWD || undefined
  };
  updateInbox(inboxPathsFor(hitlFile), (live) => [
    item,
    ...live
  ]);
  mirrorHitlToSlack(item, hitlFile);
  emitActivityRaw({
    kind: "blocked",
    title: `Inbox \xB7 ${title}`,
    detail: action || detail || "",
    repo,
    hitlId: item.id,
    runId,
    suppressTelegram: true
  });
  const row = [{ text: "\u2705 Resolve", callback_data: `hitl:resolve:${item.id}` }];
  if (runId)
    row.push({ text: "\uD83E\uDEB5 Tail run", callback_data: `run:tail:${runId}` });
  if (!slackQuietsTelegram())
    pingTelegram(`\u26D4 Inbox \xB7 ${title}${action ? ` \u2014 ${action}` : ""}`, [row]);
  return { id: item.id };
}
function resolveHitlTool(args) {
  const { id, resolved = true } = args;
  if (!id)
    throw new Error("id is required");
  const hitlFile = HITL_FILE();
  let updated = null;
  let wasOpen = false;
  const wrote = updateInbox(inboxPathsFor(hitlFile), (cur) => {
    const idx = cur.findIndex((h) => h.id === id);
    if (idx < 0)
      return;
    wasOpen = cur[idx].status === "open";
    updated = {
      ...cur[idx],
      status: resolved ? "resolved" : "open",
      resolvedAt: resolved ? Date.now() : undefined,
      ...resolved ? {} : { readAt: undefined }
    };
    const next = cur.slice();
    next[idx] = updated;
    return next;
  }, resolved ? {} : { include: [id] });
  if (!wrote || !updated)
    return { ok: false };
  const item = updated;
  if (resolved && wasOpen) {
    if (item.slackChannel && item.slackTs) {
      const cfg = slackCfg();
      if (cfg)
        trackEffect(slackApi(cfg.botToken, "reactions.add", {
          channel: item.slackChannel,
          timestamp: item.slackTs,
          name: "white_check_mark"
        }).catch(() => {}));
    }
    emitActivityRaw({
      kind: "task-complete",
      title: `Inbox resolved \xB7 ${item.title || "Untitled"}`,
      detail: item.action || item.detail || "",
      repo: item.repo,
      repoRoot: item.repoRoot,
      hitlId: item.id,
      runId: item.runId
    });
  }
  return { ok: true };
}
function emitActivityRaw({
  kind,
  title,
  detail,
  repo,
  repoRoot,
  hitlId,
  runId,
  suppressTelegram
}) {
  mkdirSync2(CFG(), { recursive: true });
  const file = ACTIVITY_FILE();
  const ev = {
    id: randomUUID2(),
    ts: Date.now(),
    kind: kind || "info",
    title: title || "",
    detail: detail || "",
    repo: repo || "",
    repoRoot: repoRoot || "",
    ...hitlId ? { hitlId } : {},
    ...runId ? { runId, runSource: "agent" } : {},
    ...suppressTelegram ? { suppressTelegram: true } : {}
  };
  try {
    appendFileSync2(file, JSON.stringify(ev) + `
`);
  } catch {}
  return ev;
}
function emitActivityTool(args) {
  emitActivityRaw(args);
  return { ok: true };
}
function stateFilePath(repoArg, agentId) {
  if (!repoArg)
    throw new Error("repo is required");
  if (!agentId)
    throw new Error("agent is required");
  const root = findRepoRoot(repoArg);
  const slug = root ? basename5(root) : repoArg;
  return join9(CFG(), "agent-state", slug, `${agentId}.json`);
}
function setAgentStateTool(args) {
  const { repo, agent, key, value } = args;
  if (!key)
    throw new Error("key is required");
  const file = stateFilePath(repo, agent);
  mkdirSync2(dirname3(file), { recursive: true });
  let state = {};
  try {
    if (existsSync7(file))
      state = JSON.parse(readFileSync7(file, "utf8"));
  } catch {}
  state[key] = value;
  state.lastRunAt = Date.now();
  writeFileSync2(file, JSON.stringify(state, null, 2) + `
`);
  return { ok: true };
}
function getAgentStateTool(args) {
  const { repo, agent, key } = args;
  const file = stateFilePath(repo, agent);
  if (!existsSync7(file))
    return key ? { value: null } : { state: {} };
  try {
    const s = JSON.parse(readFileSync7(file, "utf8"));
    return key ? { value: s[key] ?? null } : { state: s };
  } catch {
    return key ? { value: null } : { state: {} };
  }
}
var ACTIVITY_SCAN_LIMIT = 20000;
function listActivityTool(args) {
  const { kind, repo, sinceMs, limit = 50 } = args || {};
  const wantRepo = repo ? String(repo).toLowerCase() : "";
  const { events } = readActivityPage(ACTIVITY_FILE(), {
    limit,
    maxScan: ACTIVITY_SCAN_LIMIT,
    filter: (ev) => {
      if (kind && ev.kind !== kind)
        return false;
      if (wantRepo && !(ev.repo || "").toLowerCase().includes(wantRepo))
        return false;
      if (sinceMs && ev.ts < sinceMs)
        return false;
      return true;
    }
  });
  return events.map((ev) => ({
    id: ev.id,
    ts: ev.ts,
    kind: ev.kind,
    title: ev.title,
    detail: typeof ev.detail === "string" ? ev.detail.slice(0, 200) : ev.detail,
    repo: ev.repo
  }));
}
function listHitlTool(args) {
  const { status = "open", repo, limit = 50 } = args || {};
  const file = HITL_FILE();
  if (!existsSync7(file))
    return [];
  try {
    const paths = inboxPathsFor(file);
    const arr = readInboxLive(paths);
    if (status !== "open") {
      let cursor = undefined;
      for (let page = 0;page < 200 && arr.length < limit * 4; page++) {
        const res = readInboxArchive(paths, { cursor, limit: 200 });
        arr.push(...res.items);
        if (res.done)
          break;
        cursor = res.cursor;
      }
    }
    return arr.filter((h) => status === "all" ? true : h.status === status).filter((h) => !repo || (h.repo || "").toLowerCase().includes(repo.toLowerCase())).slice(0, limit).map((h) => ({
      id: h.id,
      title: h.title,
      action: h.action,
      detail: typeof h.detail === "string" ? h.detail.slice(0, 300) : h.detail,
      repo: h.repo,
      source: h.source,
      status: h.status,
      createdAt: h.createdAt,
      resolvedAt: h.resolvedAt
    }));
  } catch {
    return [];
  }
}
function listBgTasksTool(args) {
  const { status, repo, limit = 20 } = args || {};
  const file = join9(CFG(), "bg-tasks.json");
  if (!existsSync7(file))
    return [];
  try {
    const arr = JSON.parse(readFileSync7(file, "utf8"));
    return arr.filter((t) => !status || t.status === status).filter((t) => !repo || (t.repo || "").toLowerCase().includes(repo.toLowerCase())).slice(0, limit);
  } catch {
    return [];
  }
}
function harnessStatusTool() {
  const hitlFile = HITL_FILE();
  let hitlOpen = 0;
  try {
    hitlOpen = inboxCounts(inboxPathsFor(hitlFile)).live;
  } catch {}
  const cronDir = join9(CFG(), "cron-runs");
  let cronRunning = 0;
  let cronFailed24h = 0;
  if (existsSync7(cronDir)) {
    const dayAgo = Date.now() - 86400000;
    try {
      for (const f of readdirSync5(cronDir)) {
        if (!f.endsWith(".json"))
          continue;
        try {
          const r = JSON.parse(readFileSync7(join9(cronDir, f), "utf8"));
          if (r.status === "running")
            cronRunning++;
          if (r.status === "failed" && r.startedAt >= dayAgo)
            cronFailed24h++;
        } catch {}
      }
    } catch {}
  }
  let bgRunning = 0;
  try {
    const bf = join9(CFG(), "bg-tasks.json");
    if (existsSync7(bf)) {
      const arr = JSON.parse(readFileSync7(bf, "utf8"));
      bgRunning = arr.filter((t) => t.status === "running").length;
    }
  } catch {}
  const spend = aiSpendToday({});
  return {
    hitlOpen,
    cronRunning,
    cronFailed24h,
    bgRunning,
    spendTodayUsd: spend.totalUsd,
    spendByModel: spend.byModel
  };
}
function setRunOutcomeTool(args) {
  const { runId, outcome } = args;
  if (!runId || !outcome)
    throw new Error("runId and outcome are required");
  const dir = join9(CFG(), "ai-runs");
  if (!existsSync7(dir))
    return { ok: false, reason: "no ai-runs/ dir" };
  let updated = 0;
  for (const f of readdirSync5(dir)) {
    if (!f.endsWith(".json"))
      continue;
    const path = join9(dir, f);
    try {
      const r = JSON.parse(readFileSync7(path, "utf8"));
      if (r.runId === runId) {
        r.outcome = outcome;
        writeFileSync2(path, JSON.stringify(r, null, 2));
        updated++;
      }
    } catch {}
  }
  return { ok: updated > 0, updated };
}

// src/mcp/agents.ts
var DEFAULT_AGENT_SUMMARIES = [
  ["factory", "Run /factory"],
  ["docs", "Improve docs"],
  ["deep-audit", "Deep audit"],
  ["ticket-pr-cleanup", "Ticket / PR cleanup"],
  ["test-coverage", "Strengthen tests"],
  ["code-review", "Code review"],
  ["security-sweep", "Security sweep"],
  ["perf-pass", "Performance pass"],
  ["dep-upgrade", "Dependency hygiene"],
  ["dead-code", "Dead-code cleanup"],
  ["comments-inspector", "Comments inspector"],
  ["product-audit", "Product audit"],
  ["friction-hunter", "Friction hunter"],
  ["red-team-audit", "Red-team audit"],
  ["intelligence", "Intelligence sweep"],
  ["strategy", "Strategy review"],
  ["cert-check", "TLS / cert check"],
  ["translations-check", "Translations check"],
  ["changelog", "Changelog update"],
  ["simplification", "Simplification pass"],
  ["devils-advocate", "Devil's advocate"],
  ["bloat-check", "Bloat check"],
  ["knowledge-base", "Knowledge base sweep"],
  ["ci-improver", "CI improver"],
  ["summary", "Daily summary"],
  ["beacon", "Process Beacon feedback"],
  ["emergency-fix", "Emergency fix"],
  ["unblock-ci", "Unblock CI"],
  ["revert-main", "Revert last main commit"]
];
function pushAgent(out, seen, agent) {
  const key = `${agent.kind || "classic"}:${agent.scope || "global"}:${agent.id}`;
  if (seen.has(key))
    return;
  seen.add(key);
  out.push(agent);
}
function agentDefinitionHints(meta) {
  if (!meta || typeof meta !== "object")
    return {};
  const modelPolicy = meta.modelPolicy && typeof meta.modelPolicy === "object" ? meta.modelPolicy : {};
  const quality = meta.quality && typeof meta.quality === "object" ? meta.quality : {};
  const hints = {};
  const model = modelPolicy.default || meta.model;
  if (model)
    hints.model = model;
  if (modelPolicy.cheap)
    hints.cheapModel = modelPolicy.cheap;
  if (modelPolicy.deep)
    hints.deepModel = modelPolicy.deep;
  if (modelPolicy.judge || quality?.judge?.model)
    hints.judgeModel = modelPolicy.judge || quality.judge.model;
  const acceptanceCriteria = Array.isArray(quality.acceptanceCriteria) ? quality.acceptanceCriteria.length : 0;
  const deterministicChecks = Array.isArray(quality.deterministicChecks) ? quality.deterministicChecks.length : 0;
  const requiredArtifacts = Array.isArray(quality.requiredArtifacts) ? quality.requiredArtifacts.length : 0;
  if (acceptanceCriteria || deterministicChecks || requiredArtifacts || quality?.judge?.enabled) {
    hints.quality = {
      acceptanceCriteria,
      deterministicChecks,
      requiredArtifacts,
      judge: quality?.judge?.enabled ? quality.judge.mode || "llm" : "off"
    };
  }
  if (typeof meta.outputContract === "string" && meta.outputContract.trim()) {
    hints.outputContract = meta.outputContract.trim().slice(0, 160);
  }
  return hints;
}
function listAgentsTool(args) {
  const root = args.repo ? findRepoRoot(args.repo) : process.env.TERMINAL_REPO || null;
  if (!root)
    return { error: "unknown repo; pass repo=<basename> or set TERMINAL_REPO" };
  const out = [];
  const seen = new Set;
  for (const [id, title] of DEFAULT_AGENT_SUMMARIES) {
    pushAgent(out, seen, { id, title, scope: "global", kind: "classic", source: "default" });
  }
  const globalJson = join10(CFG(), "agents", "global.json");
  if (existsSync8(globalJson)) {
    try {
      const list = JSON.parse(readFileSync8(globalJson, "utf8"));
      const arr = Array.isArray(list) ? list : [];
      for (const a of arr) {
        if (a?.id && a?.title)
          pushAgent(out, seen, {
            id: a.id,
            title: a.title,
            scope: "global",
            kind: "classic",
            source: "global",
            description: a.description,
            ...agentDefinitionHints(a)
          });
      }
    } catch {}
  }
  const localJson = join10(root, ".agents", "agents.json");
  if (existsSync8(localJson)) {
    try {
      const list = JSON.parse(readFileSync8(localJson, "utf8"));
      const arr = Array.isArray(list) ? list : Array.isArray(list?.agents) ? list.agents : [];
      for (const a of arr) {
        if (a?.id && a?.title)
          pushAgent(out, seen, {
            id: a.id,
            title: a.title,
            scope: "repo",
            kind: "classic",
            source: "repo",
            force: !!a.force,
            opensPr: !!a.opensPr,
            inPlace: !!a.inPlace,
            description: a.description,
            ...agentDefinitionHints(a)
          });
      }
    } catch {}
  }
  if (existsSync8(join10(root, ".agents"))) {
    try {
      for (const f of readdirSync6(join10(root, ".agents"))) {
        if (!f.endsWith(".sh"))
          continue;
        const id = f.slice(0, -3);
        let meta = {};
        try {
          const p = join10(root, ".agents", `${id}.json`);
          if (existsSync8(p))
            meta = JSON.parse(readFileSync8(p, "utf8"));
        } catch {}
        pushAgent(out, seen, {
          id,
          title: meta.title || id,
          scope: "repo",
          kind: "classic",
          source: "repo-script",
          description: meta.description,
          ...agentDefinitionHints(meta)
        });
      }
    } catch {}
  }
  const globalScripts = join10(CFG(), "scripts");
  if (existsSync8(globalScripts)) {
    try {
      for (const f of readdirSync6(globalScripts)) {
        if (!f.endsWith(".sh"))
          continue;
        const id = f.slice(0, -3);
        let meta = {};
        try {
          const p = join10(globalScripts, `${id}.json`);
          if (existsSync8(p))
            meta = JSON.parse(readFileSync8(p, "utf8"));
        } catch {}
        pushAgent(out, seen, {
          id,
          title: meta.title || id,
          scope: "global",
          kind: "classic",
          source: "global-script",
          description: meta.description,
          ...agentDefinitionHints(meta)
        });
      }
    } catch {}
  }
  const persistentRoot = join10(CFG(), "persistent-agents");
  if (existsSync8(persistentRoot)) {
    try {
      for (const id of readdirSync6(persistentRoot)) {
        const metaPath = join10(persistentRoot, id, "agent.json");
        if (!existsSync8(metaPath))
          continue;
        try {
          const meta = JSON.parse(readFileSync8(metaPath, "utf8"));
          pushAgent(out, seen, {
            id,
            title: meta.title || id,
            scope: "global",
            kind: "persistent",
            source: "persistent",
            description: meta.description,
            ...agentDefinitionHints(meta)
          });
        } catch {}
      }
    } catch {}
  }
  return { repo: basename6(root), agents: out.sort((a, b) => a.id.localeCompare(b.id)) };
}
function noteFirstDelegation(title, repo, agentId) {
  try {
    const sessionId = process.env.GT_TERMINAL_SESSION_ID || "";
    const dir = join10(CFG(), "delegation-seen");
    mkdirSync3(dir, { recursive: true, mode: 448 });
    const marker = join10(dir, `${(sessionId || "no-session").replace(/[^\w-]/g, "_")}.json`);
    if (existsSync8(marker))
      return;
    writeFileSync3(marker, JSON.stringify({ at: Date.now(), repo, agentId }), { mode: 384 });
    emitActivityRaw({
      kind: "info",
      title: `Agent delegated work \xB7 ${repo}`,
      detail: `An agent spawned a delegated ${agentId} run ("${title}"). Further delegations this session are not announced.`,
      repo,
      suppressTelegram: true
    });
  } catch {}
}
function requestAgentArtifactTool(args) {
  const root = args.repo ? findRepoRoot(args.repo) : process.env.TERMINAL_REPO || null;
  if (!root)
    throw new Error("unknown repo; pass repo or set TERMINAL_REPO");
  const prompt = typeof args.prompt === "string" ? args.prompt.trim() : "";
  if (!prompt)
    throw new Error("prompt is required");
  const title = typeof args.title === "string" && args.title.trim() ? args.title.trim() : "Agent artifact request";
  const agent = normalizeTicketAgent({
    agentId: args.agentId || "knowledge-base",
    agentScope: args.agentScope || "global",
    agentKind: args.agentKind || "classic"
  }, "feature");
  const timeoutMs = Math.max(30000, Math.min(Number(args.timeoutMs || 180000), 600000));
  const model = typeof args.model === "string" && args.model.trim() ? args.model.trim() : "";
  const runSlug = `${new Date().toISOString().replace(/[:.]/g, "-")}-${slugify(title)}`;
  const dir = join10(statePathForWrite(root, "agent-requests") || join10(root, ".TerMinal", "agent-requests"), runSlug);
  mkdirSync3(dir, { recursive: true });
  const promptPath = join10(dir, "prompt.md");
  const reportPath = join10(dir, "report.md");
  const metaPath = join10(dir, "artifact.json");
  const fullPrompt = `You are a delegated TerMinal agent request.

Agent: ${agent.kind}:${agent.scope}:${agent.id}
Repo: ${basename6(root)}
Working directory: ${root}

Task:
${prompt}

Rules:
- Stay focused on this request; do not implement code unless explicitly asked.
- Re-read files from disk instead of asking the parent agent for pasted context.
- Return a concise markdown artifact with: Summary, Findings, Evidence/Paths, and Recommended next steps.
- If follow-up implementation is needed, recommend exactly which agent should own it.
`;
  writeFileSync3(promptPath, fullPrompt);
  noteFirstDelegation(title, basename6(root), agent.id);
  const child = spawnSync("claude", ["-p", fullPrompt, "--permission-mode", "auto", ...model ? ["--model", model] : []], {
    cwd: root,
    encoding: "utf8",
    timeout: timeoutMs,
    maxBuffer: 20 * 1024 * 1024,
    env: {
      ...process.env,
      TERMINAL_DELEGATE_AGENT_ID: agent.id,
      TERMINAL_DELEGATE_AGENT_SCOPE: agent.scope,
      TERMINAL_DELEGATE_AGENT_KIND: agent.kind
    }
  });
  const stdout = child.stdout || "";
  const stderr = child.stderr || "";
  const errorMessage = child.error?.message || "";
  const timedOut = child.error && child.error.code === "ETIMEDOUT";
  const ok = !child.error && (child.status === 0 || child.status === null);
  const body = stdout.trim() || (stderr.trim() ? `Delegated agent wrote no stdout.

## stderr

\`\`\`
${stderr.trim().slice(0, 8000)}
\`\`\`` : `Delegated agent wrote no stdout.${errorMessage ? `

## error

\`\`\`
${errorMessage}
\`\`\`` : ""}`);
  writeFileSync3(reportPath, `---
title: ${JSON.stringify(title)}
repo: ${basename6(root)}
agent_id: ${agent.id}
agent_scope: ${agent.scope}
agent_kind: ${agent.kind}
created: ${new Date().toISOString()}
ok: ${ok}
---

${body}
`);
  const summary = body.split(`
`).map((line) => line.trim()).filter((line) => line && !line.startsWith("#")).slice(0, 6).join(`
`).slice(0, 1200);
  const meta = {
    title,
    kind: "agent-artifact",
    createdAt: new Date().toISOString(),
    agent,
    ok,
    status: child.status,
    signal: child.signal,
    timedOut: !!timedOut,
    promptPath,
    primaryPath: reportPath,
    summary
  };
  writeFileSync3(metaPath, JSON.stringify(meta, null, 2) + `
`);
  emitActivityRaw({
    kind: ok ? "agent-run" : "error",
    title: `Agent artifact \xB7 ${agent.id}`,
    detail: title,
    repo: basename6(root),
    repoRoot: root
  });
  return {
    ok,
    repo: basename6(root),
    agent,
    artifactPath: reportPath,
    promptPath,
    metaPath,
    summary,
    status: child.status,
    signal: child.signal,
    timedOut: !!timedOut
  };
}

// src/mcp/insights.ts
import { execFileSync as execFileSync2 } from "child_process";
import { existsSync as existsSync9, readFileSync as readFileSync9, readdirSync as readdirSync7, statSync as statSync4 } from "fs";
import { homedir as homedir3 } from "os";
import { basename as basename7, join as join11 } from "path";
function listReviewPatternsTool(args) {
  const harness = configuredHarnessDir();
  if (!harness)
    return { error: "no harnessDir configured in ~/.config/TerMinal/settings.json" };
  const path = join11(harness, "reports", "review-patterns.md");
  if (!existsSync9(path))
    return { error: "no review patterns report yet; runs nightly via bin/review-findings-mine" };
  const limit = typeof args?.limit === "number" ? Math.max(1, Math.min(50, args.limit)) : 10;
  const raw = readFileSync9(path, "utf8");
  const out = [];
  const sections = raw.split(/^## /m).slice(1);
  for (const sec of sections) {
    const lines = sec.split(`
`);
    const title = (lines[0] || "").trim();
    const meta = lines.slice(1, 12).filter((l) => l.trim()).slice(0, 8);
    out.push({ title, summary: meta.join(`
`) });
    if (out.length >= limit)
      break;
  }
  return { count: out.length, patterns: out };
}
function factoryHealthTool() {
  const out = [];
  for (const root of knownRepoRoots()) {
    const repo = basename7(root);
    const repoOut = {
      repo,
      ticketCounts: { open: 0, inProgress: 0, closed: 0, stuck: 0, icebox: 0 },
      openPrs: 0
    };
    const backlogs = backlogReadDirs(root);
    for (const backlog of backlogs) {
      try {
        for (const f of readdirSync7(backlog)) {
          if (!/^\d{4}-.*\.md$/.test(f))
            continue;
          try {
            const { meta } = parseFrontmatter(readFileSync9(join11(backlog, f), "utf8"));
            const s = meta.status || "open";
            if (s === "open")
              repoOut.ticketCounts.open++;
            else if (s === "in-progress")
              repoOut.ticketCounts.inProgress++;
            else if (s === "closed")
              repoOut.ticketCounts.closed++;
            else if (s === "stuck")
              repoOut.ticketCounts.stuck++;
            else if (s === "icebox")
              repoOut.ticketCounts.icebox++;
          } catch {}
        }
      } catch {}
    }
    out.push(repoOut);
  }
  try {
    const root = prsRoot();
    if (!root)
      return { repos: out.sort((a, b) => b.ticketCounts.open - a.ticketCounts.open) };
    const cf = join11(root, "cache.json");
    if (existsSync9(cf)) {
      const cache = JSON.parse(readFileSync9(cf, "utf8"));
      const prs = Array.isArray(cache?.prs) ? cache.prs : [];
      for (const pr of prs) {
        const repoBase = basename7(String(pr.repo || ""));
        const r = out.find((x) => x.repo === repoBase || pr.repo?.endsWith(x.repo));
        if (r && (pr.state || "").toLowerCase() === "open")
          r.openPrs++;
      }
    }
  } catch {}
  return { repos: out.sort((a, b) => b.ticketCounts.open - a.ticketCounts.open) };
}
function searchDecisionsTool(args) {
  const q = (args?.query || "").trim().toLowerCase();
  if (!q)
    return { error: "query is required" };
  const limit = typeof args?.limit === "number" ? Math.max(1, Math.min(50, args.limit)) : 20;
  const repoArg = args?.repo;
  const roots = repoArg ? [findRepoRoot(repoArg)].filter(Boolean) : knownRepoRoots();
  const out = [];
  for (const root of roots) {
    for (const sub of ["docs/decisions", "docs/learnings", "docs/runbooks"]) {
      const dir = join11(root, sub);
      if (!existsSync9(dir))
        continue;
      let entries;
      try {
        entries = readdirSync7(dir);
      } catch {
        continue;
      }
      for (const f of entries) {
        if (!f.endsWith(".md"))
          continue;
        const path = join11(dir, f);
        let raw;
        try {
          raw = readFileSync9(path, "utf8");
        } catch {
          continue;
        }
        const lower = raw.toLowerCase();
        if (!lower.includes(q))
          continue;
        const { meta } = parseFrontmatter(raw);
        const idx = lower.indexOf(q);
        const lineStart = lower.lastIndexOf(`
`, idx) + 1;
        const lineEnd = lower.indexOf(`
`, idx);
        const snippet = raw.slice(lineStart, lineEnd > 0 ? lineEnd : lineStart + 200);
        out.push({
          repo: basename7(root),
          path: path.replace(homedir3(), "~"),
          kind: sub.split("/")[1],
          title: meta.title || f.replace(/\.md$/, ""),
          status: meta.status,
          tags: meta.tags,
          snippet: snippet.trim().slice(0, 200)
        });
        if (out.length >= limit)
          return { count: out.length, hits: out };
      }
    }
  }
  return { count: out.length, hits: out };
}
function recentChangesTool(args) {
  const root = args?.repo ? findRepoRoot(args.repo) : process.env.TERMINAL_REPO || null;
  if (!root)
    return { error: "unknown repo; pass repo=<basename> or set TERMINAL_REPO" };
  const days = typeof args?.days === "number" ? Math.max(1, Math.min(90, args.days)) : 7;
  const limit = typeof args?.limit === "number" ? Math.max(1, Math.min(200, args.limit)) : 50;
  try {
    const out = execFileSync2("git", [
      "-C",
      root,
      "log",
      `--since=${days} days ago`,
      `-n`,
      String(limit),
      "--pretty=format:%h|%an|%ar|%s"
    ], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
    const commits = out.split(`
`).filter(Boolean).map((line) => {
      const [sha, author, when, ...subjectParts] = line.split("|");
      return { sha, author, when, subject: subjectParts.join("|") };
    });
    return { repo: basename7(root), days, count: commits.length, commits };
  } catch (e) {
    return { error: `git log failed: ${e.message}` };
  }
}
function nearestSessionTool(args) {
  const root = args?.repo ? findRepoRoot(args.repo) : process.env.TERMINAL_REPO || null;
  if (!root)
    return { error: "unknown repo; pass repo=<basename> or set TERMINAL_REPO" };
  const limit = typeof args?.limit === "number" ? Math.max(1, Math.min(20, args.limit)) : 5;
  const slug = "-" + root.replace(/^\//, "").replace(/\//g, "-");
  const dir = join11(homedir3(), ".claude", "projects", slug);
  if (!existsSync9(dir))
    return {
      repo: basename7(root),
      sessions: [],
      hint: `no transcript dir at ~/.claude/projects/${slug}`
    };
  let files;
  try {
    files = readdirSync7(dir);
  } catch {
    return { error: `cannot read ${dir}` };
  }
  const sessions = files.filter((f) => f.endsWith(".jsonl")).map((f) => {
    const path = join11(dir, f);
    let stat;
    try {
      stat = statSync4(path);
    } catch {
      return null;
    }
    return {
      id: f.replace(/\.jsonl$/, ""),
      modifiedMs: stat.mtimeMs,
      sizeBytes: stat.size,
      path: path.replace(homedir3(), "~")
    };
  }).filter(Boolean).sort((a, b) => b.modifiedMs - a.modifiedMs).slice(0, limit);
  return { repo: basename7(root), count: sessions.length, sessions };
}

