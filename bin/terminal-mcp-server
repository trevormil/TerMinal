import { existsSync as existsSync3, readFileSync as readFileSync2, readdirSync as readdirSync2 } from "fs";
import { basename as basename2, join as join5 } from "path";
function readTicketConfig(root) {
  try {
    const p = statePathForRead(root, "tickets.json");
    if (!existsSync3(p))
      return {};
    const parsed = JSON.parse(readFileSync2(p, "utf8"));
    return parsed && typeof parsed === "object" ? parsed : {};
  } catch {
    return {};
  }
}
function backlogReadDirs(root) {
  return areaPathsFor(root, "backlog");
}
function backlogWriteDir(root) {
  return areaPath(root, "backlog");
}
function parseFrontmatter(md) {
  const m = md.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
  if (!m)
    return { meta: {}, body: md };
  const meta = {};
  for (const line of m[1].split(/\r?\n/)) {
    const lm = line.match(/^([A-Za-z_][\w-]*):\s*(.*)$/);
    if (!lm)
      continue;
    const raw = lm[2].trim();
    if (!raw)
      continue;
    let val = raw;
    if (raw === "true" || raw === "false")
      val = raw === "true";
    else if (/^-?\d+(\.\d+)?$/.test(raw))
      val = Number(raw);
    else if (raw.startsWith('"') && raw.endsWith('"'))
      val = raw.slice(1, -1);
    else if (raw.startsWith("[") && raw.endsWith("]")) {
      val = raw.slice(1, -1).split(",").map((s) => s.trim().replace(/^["']|["']$/g, "")).filter(Boolean);
    }
    meta[lm[1]] = val;
  }
  return { meta, body: m[2] || "" };
}
function knownRepoRoots() {
  const roots = new Set;
  try {
    const sf = join5(CFG(), "schedules.json");
    if (existsSync3(sf)) {
      const arr = JSON.parse(readFileSync2(sf, "utf8"));
      for (const s of arr)
        if (s.repoRoot)
          roots.add(s.repoRoot);
    }
  } catch {}
  try {
    const bf = join5(CFG(), "bg-tasks.json");
    if (existsSync3(bf)) {
      const arr = JSON.parse(readFileSync2(bf, "utf8"));
      for (const t of arr)
        if (t.repoRoot)
          roots.add(t.repoRoot);
    }
  } catch {}
  const parent = configuredProjectsDir();
  if (existsSync3(parent)) {
    try {
      for (const name of readdirSync2(parent)) {
        const p = join5(parent, name);
        if (name.startsWith("."))
          continue;
        if (existsSync3(join5(p, ".git")))
          roots.add(p);
      }
    } catch {}
  }
  return [...roots];
}
function findRepoRoot(repoArg) {
  if (!repoArg)
    return null;
  const target = repoArg.toLowerCase();
  for (const root of knownRepoRoots()) {
    const b = basename2(root).toLowerCase();
    if (b === target || root.toLowerCase().endsWith(target))
      return root;
  }
  return null;
}

