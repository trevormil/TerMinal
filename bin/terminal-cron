// src/runner/ai-runs.ts
import { mkdirSync as mkdirSync3 } from "fs";
import { join as join4 } from "path";
import { randomUUID as randomUUID4 } from "crypto";
var PER_M_PRICING = {
  haiku: { in: 1, out: 5, cacheRead: 0.1 },
  sonnet: { in: 3, out: 15, cacheRead: 0.3 },
  opus: { in: 15, out: 75, cacheRead: 1.5 },
  "claude-haiku-4-5": { in: 1, out: 5, cacheRead: 0.1 },
  "claude-sonnet-4-6": { in: 3, out: 15, cacheRead: 0.3 },
  "claude-opus-4-7": { in: 15, out: 75, cacheRead: 1.5 },
  "claude-opus-4-8": { in: 15, out: 75, cacheRead: 1.5 },
  "gpt-5": { in: 1.25, out: 10 },
  "gpt-5-codex": { in: 1.25, out: 10 },
  "gpt-5-mini": { in: 0.25, out: 2 },
  "o4-mini": { in: 0.6, out: 2.4 }
};
function priceFor(model) {
  const m = (model || "").toLowerCase().trim();
  if (PER_M_PRICING[m])
    return PER_M_PRICING[m];
  let best = null;
  for (const [key, val] of Object.entries(PER_M_PRICING)) {
    if (m.startsWith(key) && (!best || key.length > best.key.length))
      best = { key, val };
  }
  return best?.val || { in: 0, out: 0 };
}
function parseUsageFromOutput(out) {
  let input = 0;
  let output = 0;
  let cacheRead = 0;
  let model = "";
  const lines = out.split(`
`).slice(-200);
  for (const raw of lines) {
    const line = raw.replace(/\x1b\[[0-9;?]*[a-zA-Z]/g, "");
    let m;
    if ((m = line.match(/(?:input|prompt)\s*tokens?[:\s]+(\d[\d,]*)/i)) && input === 0) {
      input = parseInt(m[1].replace(/,/g, ""), 10);
    }
    if ((m = line.match(/(?:output|completion)\s*tokens?[:\s]+(\d[\d,]*)/i)) && output === 0) {
      output = parseInt(m[1].replace(/,/g, ""), 10);
    }
    if ((m = line.match(/cache(?:d|\s*read)?[:\s]+(\d[\d,]*)/i)) && cacheRead === 0) {
      cacheRead = parseInt(m[1].replace(/,/g, ""), 10);
    }
    if (!model && (m = line.match(/model[:\s]+([\w\-.]+)/i)))
      model = m[1];
  }
  return input || output ? { input, output, cacheRead, model } : null;
}
function writeAIRun(opts) {
  try {
    mkdirSync3(AI_RUNS_DIR(), { recursive: true });
    const price = priceFor(opts.model);
    const cost = (opts.inputTokens * price.in + opts.outputTokens * price.out + (opts.cacheReadTokens || 0) * (price.cacheRead || price.in)) / 1e6;
    const rec = {
      id: randomUUID4(),
      source: opts.engine === "codex" ? "codex-exec" : "claude-p",
      startedAt: opts.startedAt,
      endedAt: opts.endedAt,
      model: opts.model || (opts.engine === "codex" ? "gpt-5" : "sonnet"),
      inputTokens: opts.inputTokens,
      outputTokens: opts.outputTokens,
      cacheReadTokens: opts.cacheReadTokens || 0,
      costUsd: cost,
      repoRoot: opts.repoRoot,
      runId: opts.runId,
      agentId: opts.agentId,
      durationMs: opts.endedAt - opts.startedAt,
      exitCode: opts.exitCode
    };
    writeJsonAtomicShared(join4(AI_RUNS_DIR(), `${rec.id}.json`), rec);
  } catch (e) {
    log(`ai-run write failed: ${e}`);
  }
}

// src/runner/disabled.ts
function readDisabled() {
  const a = readJson(DISABLED_FILE());
  const ids = Array.isArray(a) ? a : a?.scheduleIds || [];
  return new Set(ids);
}
function readDisabledReasons() {
  const a = readJson(DISABLED_FILE());
  return !Array.isArray(a) && a?.reasons && typeof a.reasons === "object" ? a.reasons : {};
}
function writeDisabled(set, extraReasons = {}) {
  try {
    withFileLockShared(DISABLED_FILE(), () => {
      const ids = [...set];
      const reasons = { ...readDisabledReasons(), ...extraReasons };
      const kept = {};
      for (const id of ids)
        if (reasons[id])
          kept[id] = reasons[id];
      writeJsonAtomicShared(DISABLED_FILE(), { scheduleIds: ids, reasons: kept });
    });
  } catch (e) {
    log(`failed writing disabled: ${e}`);
  }
}

// src/runner/engine-cmd.ts
import { existsSync as existsSync5 } from "fs";
import { join as join7 } from "path";

// src/runner/git.ts
import { execFileSync } from "child_process";
var git = (repo, args) => execFileSync("git", ["-C", repo, ...args], {
  encoding: "utf8",
  stdio: ["ignore", "pipe", "pipe"]
}).trim();
var shq = (s) => `'${String(s).replace(/'/g, "'\\''")}'`;
function defaultBase(repo) {
  try {
    return git(repo, ["symbolic-ref", "--short", "refs/remotes/origin/HEAD"]).replace(/^origin\//, "");
  } catch {}
  try {
    return git(repo, ["rev-parse", "--abbrev-ref", "HEAD"]);
  } catch {
    return "main";
  }
}

// src/runner/repo-state.ts
import { existsSync as existsSync4 } from "fs";
import { join as join6 } from "path";

// src/runner/repo-state-block.js
import { execFileSync as execFileSync2 } from "child_process";
import { createHash } from "crypto";
import { existsSync as existsSync3, readdirSync as readdirSync2 } from "fs";
import { basename, join as join5 } from "path";
function makeRepoState(CFG2) {
  const SIDECAR_AREAS = ["backlog", "sessions", "reviews", "checks", "reports"];
  const repoStateKeyCache = new Map;
  function repoStateDir() {
    return process.env.TERMINAL_REPO_STATE_DIR?.trim() || join5(CFG2, "repos");
  }
  function gitOut(root, args) {
    try {
      return execFileSync2("git", ["-C", root, ...args], {
        encoding: "utf8",
        stdio: ["ignore", "pipe", "ignore"]
      }).trim();
    } catch {
      return "";
    }
  }
  function parseRemoteKey(url) {
    const u = (url || "").trim().replace(/\/+$/, "").replace(/\.git$/, "");
    const m = u.match(/^[a-z][a-z0-9+.-]*:\/\/(?:[^@/]+@)?([^/:]+)(?::\d+)?\/(.+)$/i) || u.match(/^[\w.-]+@([^:/]+)[:/](.+)$/);
    return m ? m[1] + "/" + m[2] : "";
  }
  function safeStateKey(key) {
    if (!key)
      return "";
    const parts = key.split("/");
    if (parts.some((p) => p === "" || p === "." || p === ".."))
      return "";
    return key;
  }
  function repoStateKey(root) {
    if (!root)
      return "";
    const hit = repoStateKeyCache.get(root);
    if (hit !== undefined)
      return hit;
    let key = safeStateKey(parseRemoteKey(gitOut(root, ["config", "--get", "remote.origin.url"])));
    if (!key)
      key = safeStateKey(parseRemoteKey(gitOut(root, ["remote", "get-url", "origin"])));
    if (!key) {
      let canonical = gitOut(root, ["rev-parse", "--show-toplevel"]) || root;
      const common = gitOut(root, ["rev-parse", "--path-format=absolute", "--git-common-dir"]);
      if (common && common.endsWith("/.git"))
        canonical = common.slice(0, -"/.git".length);
      const hash = createHash("sha256").update(canonical).digest("hex").slice(0, 12);
      key = "local/" + basename(canonical) + "-" + hash;
    }
    repoStateKeyCache.set(root, key);
    return key;
  }
  function sidecarAreaPath(root, area) {
    if (!root || !SIDECAR_AREAS.includes(area))
      return "";
    const key = repoStateKey(root);
    return key ? join5(repoStateDir(), key, area) : "";
  }
  function areaPathsFor(root, area, candidates) {
    const out = [];
    const sidecar = sidecarAreaPath(root, area);
    if (sidecar && existsSync3(sidecar))
      out.push(sidecar);
    for (const rel of candidates) {
      const p = join5(root, rel);
      if (existsSync3(p))
        out.push(p);
    }
    return out;
  }
  function areaWritePath(root, area, candidates, isV2) {
    const sidecar = sidecarAreaPath(root, area);
    if (sidecar)
      return sidecar;
    const existing = areaPathsFor(root, area, candidates);
    if (existing.length)
      return existing[0];
    return join5(root, isV2 ? candidates[0] : candidates[1] || candidates[0]);
  }
  function maxAreaId(dirs) {
    let max = 0;
    for (const dir of dirs) {
      if (!dir)
        continue;
      let entries = [];
      try {
        entries = readdirSync2(dir);
      } catch {
        continue;
      }
      for (const f of entries) {
        const m = /^(\d{4})-/.exec(f);
        if (m)
          max = Math.max(max, parseInt(m[1], 10));
      }
    }
    return max;
  }
  function statePathForWrite(root, rel) {
    if (!root)
      return "";
    const key = repoStateKey(root);
    return key ? join5(repoStateDir(), key, rel) : "";
  }
  function statePathForRead(root, rel) {
    const sidecar = statePathForWrite(root, rel);
    if (sidecar && existsSync3(sidecar))
      return sidecar;
    const legacy = join5(root, ".TerMinal", rel);
    if (existsSync3(legacy))
      return legacy;
    return sidecar || legacy;
  }
  function statePathSticky(root, rel) {
    const legacy = join5(root, ".TerMinal", rel);
    if (existsSync3(legacy))
      return legacy;
    return statePathForWrite(root, rel) || legacy;
  }
  function repoStateEnv(root) {
    const out = {};
    if (!root)
      return out;
    const key = repoStateKey(root);
    if (!key)
      return out;
    const base = join5(repoStateDir(), key);
    out.TERMINAL_STATE_DIR = base;
    for (const area of SIDECAR_AREAS) {
      out["TERMINAL_" + area.toUpperCase() + "_DIR"] = join5(base, area);
    }
    return out;
  }
  return {
    SIDECAR_AREAS,
    repoStateKey,
    sidecarAreaPath,
    areaPathsFor,
    areaWritePath,
    maxAreaId,
    statePathForWrite,
    statePathForRead,
    statePathSticky,
    repoStateEnv
  };
}

// src/runner/repo-state.ts
var cached = null;
function repoState() {
  const cfg = CFG();
  if (!cached || cached.cfg !== cfg)
    cached = { cfg, api: makeRepoState(cfg) };
  return cached.api;
}
function areaCandidates(area) {
  return {
    backlog: [".TerMinal/backlog", "backlog"],
    sessions: [".TerMinal/sessions", "sessions"],
    reviews: [".TerMinal/reviews", ".reviews"],
    checks: [".TerMinal/checks", ".checks", "checks"],
    reports: [".TerMinal/reports", "reports"]
  }[area] || [area];
}
function hasV2Layout(root) {
  const areas = ["backlog", "sessions", "reviews", "checks", "reports"];
  if (existsSync4(join6(root, ".TerMinal", "template.json")))
    return true;
  if (areas.some((area) => existsSync4(join6(root, areaCandidates(area)[0]))))
    return true;
  return !areas.some((area) => {
    const rels = areaCandidates(area);
    return rels.length > 1 && existsSync4(join6(root, rels[1]));
  });
}
function areaPath(root, area) {
  return repoState().areaWritePath(root, area, areaCandidates(area), hasV2Layout(root));
}
function areaPathsFor(root, area) {
  return repoState().areaPathsFor(root, area, areaCandidates(area));
}
function statePathForRead(root, rel) {
  return repoState().statePathForRead(root, rel);
}
function repoStateEnv(root) {
  return repoState().repoStateEnv(root);
}
function maxAreaId(dirs) {
  return repoState().maxAreaId(dirs);
}

// src/runner/engine-cmd.ts
var OR_PREAMBLE = "You are running FULLY AUTONOMOUSLY in a non-interactive one-shot process. " + "There is NO human reading your output and no follow-up turn \u2014 you cannot ask questions. " + "Do NOT ask for confirmation, permission, or which part to start with, and do NOT end your " + "turn with a question or a plan. Execute the ENTIRE task now: inspect the code, make all the " + "edits, run the project checks, commit, and open the PR. Keep calling tools until the work is " + "actually done. Only stop early if you are genuinely blocked \u2014 and then state the blocker explicitly.";
function resolveScriptPath(repo, agentId) {
  const perRepoScript = join7(repo, ".agents", `${agentId}.sh`);
  const globalScript = join7(CFG(), "scripts", `${agentId}.sh`);
  return existsSync5(perRepoScript) ? perRepoScript : existsSync5(globalScript) ? globalScript : null;
}
function buildCommand(sched, worktree, scriptPath) {
  const modelFlag = sched.model ? ` --model ${shq(sched.model)}` : "";
  const hermesModel = sched.model ? ` -m ${shq(sched.model)}` : "";
  const hermesUsage = join7(worktree, ".terminal-hermes-usage.json");
  const effFlag = effortFlag(sched);
  return scriptPath ? shq(scriptPath) : sched.engine === "claude" ? `claude -p ${shq(sched.prompt)} --permission-mode auto${modelFlag}${effFlag}` : sched.engine === "cursor" ? `cursor-agent -p --force --trust --output-format text --workspace ${shq(worktree)}${modelFlag} ${shq(sched.prompt)}` : sched.engine === "openrouter" ? `or-agent --dir ${shq(worktree)}${modelFlag}${effFlag} ${shq(`${OR_PREAMBLE}

${sched.prompt}`)}` : sched.engine === "openai-compat" ? `[ -n "$OPENAI_BASE_URL" ] || { echo "openai-compat: no base URL configured (TerMinal Settings \u2192 Engines \u2192 Self-hosted)"; exit 2; }; or-agent --dir ${shq(worktree)}${modelFlag}${effFlag} ${shq(`${OR_PREAMBLE}

${sched.prompt}`)}` : sched.engine === "hermes" ? `hermes -z ${shq(`${OR_PREAMBLE}

${sched.prompt}`)}${hermesModel} --usage-file ${shq(hermesUsage)} --yolo --accept-hooks` : `codex exec -s danger-full-access -C ${shq(worktree)}${modelFlag}${effFlag} ${shq(sched.prompt)}`;
}
function buildChildEnv({
  sched,
  repo,
  runId,
  branch,
  worktree
}) {
  return {
    ...process.env,
    PATH: `${TERMINAL_BIN_DIR()}:${process.env.PATH || ""}`,
    TERMINAL_REPO: repo,
    ...repoStateEnv(repo),
    TERMINAL_RUN_ID: runId,
    TERMINAL_AGENT_ID: sched.agentId,
    TERMINAL_BRANCH: branch,
    TERMINAL_WORKTREE: worktree,
    TERMINAL_ENGINE: sched.engine,
    ...sched.model || engineDefaultModel(sched.engine) ? { TERMINAL_MODEL: sched.model || engineDefaultModel(sched.engine) } : {},
    ...resolveEffort(sched) ? { TERMINAL_EFFORT: resolveEffort(sched) } : {},
    ...sched.engine === "openai-compat" ? {
      ...openAICompatBaseUrl() ? { OPENAI_BASE_URL: openAICompatBaseUrl() } : {},
      OPENAI_API_KEY: process.env.OPENAI_API_KEY || "none"
    } : {},
    ...sched.env && typeof sched.env === "object" ? sched.env : {}
  };
}
function scriptArgsFor(isMac, shell, cmd) {
  return isMac ? ["-q", "/dev/null", shell, "-l", "-c", cmd] : ["-q", "-e", "-c", `${shq(shell)} -l -c ${shq(cmd)}`, "/dev/null"];
}
function shellFor(isMac) {
  return process.env.SHELL || (isMac ? "/bin/zsh" : "/bin/bash");
}

// src/runner/runs.ts
import { existsSync as existsSync6, readdirSync as readdirSync3 } from "fs";
import { join as join9 } from "path";

// src/runner/schedules.ts
function readSchedules() {
  const a = readJson(SCHED_FILE());
  return Array.isArray(a) ? a : [];
}
function stamp(id, patch) {
  try {
    updateJsonListShared(SCHED_FILE(), (list) => {
      const i = list.findIndex((s) => s.id === id);
      if (i < 0)
        return;
      const next = [...list];
      next[i] = { ...next[i], ...patch };
      return next;
    });
  } catch (e) {
    log(`failed stamping schedule ${id}: ${e}`);
  }
}

// src/runner/tickets.ts
import { mkdirSync as mkdirSync4, writeFileSync as writeFileSync4 } from "fs";
import { join as join8 } from "path";
var localDay = (at = new Date) => `${at.getFullYear()}-${String(at.getMonth() + 1).padStart(2, "0")}-${String(at.getDate()).padStart(2, "0")}`;
function readTicketConfig(root) {
  return readJson(statePathForRead(root, "tickets.json")) || {};
}
function obsidianTicketsDir(cfg) {
  if (!cfg || cfg.provider !== "obsidian" || !cfg.obsidian || !cfg.obsidian.vaultPath)
    return null;
  const sub = String(cfg.obsidian.ticketsSubdir || "tickets").replace(/^\/+|\/+$/g, "") || "tickets";
  return join8(cfg.obsidian.vaultPath, sub);
}
function ticketWriteDir(root) {
  const cfg = readTicketConfig(root);
  const provider = String(cfg.provider || "local").toLowerCase();
  if (provider === "obsidian")
    return obsidianTicketsDir(cfg);
  if (provider === "linear" || provider === "webview" || provider === "github")
    return null;
  return areaPath(root, "backlog");
}
function fileTicket(repoRoot, input) {
  const { title, body, type = "bug", priority = "high" } = input;
  try {
    const backlogDir = ticketWriteDir(repoRoot);
    if (!backlogDir)
      return null;
    mkdirSync4(backlogDir, { recursive: true });
    const maxId = maxAreaId(areaPathsFor(repoRoot, "backlog").concat(backlogDir));
    const id = String(maxId + 1).padStart(4, "0");
    const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 50) || "cron-fail";
    const path = join8(backlogDir, `${id}-${slug}.md`);
    const today = localDay();
    const fm = `---
id: ${id}
title: ${JSON.stringify(title)}
status: open
priority: ${priority}
type: ${type}
source: cron-fail
created: ${today}
updated: ${today}
---

${body}
`;
    writeFileSync4(path, fm);
    return path;
  } catch (e) {
    log(`failed to file ticket on ${repoRoot}: ${e}`);
    return null;
  }
}

// src/runner/runs.ts
var STALE_MS = 2 * 60 * 60 * 1000;
var CIRCUIT_BREAK_AFTER = 3;
function runRecords() {
  const dir = RUNS_DIR();
  if (!existsSync6(dir))
    return [];
  const out = [];
  for (const f of readdirSync3(dir)) {
    if (!f.endsWith(".json"))
      continue;
    const path = join9(dir, f);
    const rec = readJson(path);
    if (rec)
      out.push({ path, rec });
  }
  return out;
}
function activeRunFor(scheduleId) {
  try {
    for (const { rec } of runRecords()) {
      if (rec.scheduleId === scheduleId && rec.status === "running")
        return rec;
    }
  } catch {}
  return;
}
function recentRuns(scheduleId, limit = CIRCUIT_BREAK_AFTER) {
  try {
    return runRecords().map(({ rec }) => rec).filter((rec) => rec.scheduleId === scheduleId).sort((a, b) => (b.startedAt || 0) - (a.startedAt || 0)).slice(0, limit);
  } catch {
    return [];
  }
}
function maybeCircuitBreak(scheduleId, sched) {
  const recent = recentRuns(scheduleId, CIRCUIT_BREAK_AFTER);
  if (recent.length < CIRCUIT_BREAK_AFTER)
    return false;
  if (!recent.every((r) => r.status === "failed"))
    return false;
  const set = readDisabled();
  if (set.has(scheduleId))
    return false;
  set.add(scheduleId);
  writeDisabled(set, {
    [scheduleId]: {
      reason: `auto-disabled after ${CIRCUIT_BREAK_AFTER} consecutive failures`,
      at: Date.now()
    }
  });
  fileHitl({
    title: `Circuit broken \xB7 ${sched.agentTitle}`,
    action: `auto-disabled after ${CIRCUIT_BREAK_AFTER} consecutive failures \u2014 re-enable from the Schedules tab when fixed`,
    detail: `schedule ${scheduleId} \xB7 ${sched.repoLabel}`,
    repo: sched.repoLabel,
    repoRoot: sched.repoRoot
  });
  activity({
    kind: "blocked",
    title: `Circuit broken \xB7 ${sched.agentTitle}`,
    detail: `auto-disabled after ${CIRCUIT_BREAK_AFTER} fails`,
    repo: sched.repoLabel,
    repoRoot: sched.repoRoot,
    suppressTelegram: true
  });
  log(`circuit-break: schedule ${scheduleId} (${sched.agentTitle}) disabled after ${CIRCUIT_BREAK_AFTER} fails`);
  return true;
}
function isPidAlive(pid) {
  if (!pid || typeof pid !== "number")
    return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (e) {
    return e.code !== "ESRCH";
  }
}
function sweepStaleRuns() {
  if (!existsSync6(RUNS_DIR()))
    return 0;
  let swept = 0;
  try {
    for (const { path, rec } of runRecords()) {
      if (rec.status !== "running")
        continue;
      const ageMs = rec.startedAt ? Date.now() - rec.startedAt : 0;
      const pidDead = !!rec.pid && !isPidAlive(rec.pid);
      const reapForLiveness = pidDead && ageMs > 1e4;
      const reapForAge = ageMs >= STALE_MS;
      if (!reapForLiveness && !reapForAge)
        continue;
      const reason = reapForLiveness ? `dead process (pid ${rec.pid}); runner exited without finalizing the run` : "stale: runner exited without finalizing the run (swept by watchdog)";
      const finalized = {
        ...rec,
        status: "failed",
        endedAt: Date.now(),
        error: reason
      };
      writeJsonAtomicShared(path, finalized);
      if (rec.scheduleId)
        stamp(rec.scheduleId, { lastStatus: "failed" });
      const ageMin = Math.round(ageMs / 60000);
      const detectionPhrase = reapForLiveness ? `the wrapper process (pid ${rec.pid}) is dead after ${ageMin} min` : `it was running for >${Math.round(STALE_MS / 3600000)}h with no live process`;
      const staleTicketPath = rec.repoRoot ? fileTicket(rec.repoRoot, {
        title: `Cron run stale: ${rec.agentTitle || rec.agentId}`,
        body: `The scheduled run for **${rec.agentTitle || rec.agentId}** (branch \`${rec.branch}\`) was swept by the watchdog because ${detectionPhrase}.

- run id: \`${rec.id}\`
- log: \`~/.config/TerMinal/cron-runs/${rec.id}.log\`
- worktree: \`${rec.worktree}\`

Investigate why the runner died mid-run (terminal closed, OOM, launchd killed, network hang). Fix the root cause; re-enable the schedule in the Schedules tab if the circuit-breaker tripped.`,
        type: "bug",
        priority: "high"
      }) : null;
      fileHitl({
        title: `Cron run stale \xB7 ${rec.agentTitle || rec.agentId}`,
        action: "runner died mid-run \u2014 swept by watchdog and marked failed",
        detail: `run ${rec.id} \xB7 ${rec.branch || ""}`,
        repo: rec.repoLabel,
        repoRoot: rec.repoRoot,
        runId: rec.id,
        runSource: "cron",
        ticketPath: staleTicketPath
      });
      swept++;
      log(`watchdog: marked ${rec.id} stale`);
    }
  } catch (e) {
    log(`watchdog sweep failed: ${e}`);
  }
  return swept;
}

// src/runner/run-schedule.ts
var DEFAULT_RETRY_MAX = 2;
var BACKOFF_BASE_SEC = 30;
var BACKOFF_FACTOR = 4;
var BACKOFF_MAX_SEC = 8 * 60;
var DEFAULT_TIMEOUT_MS = 30 * 60 * 1000;
var TIMEOUT_EXIT = 124;
var sleep = (ms) => new Promise((r) => setTimeout(r, ms));
var backoffMsFor = (retryIndex, baseSec) => Math.min(baseSec * BACKOFF_FACTOR ** retryIndex, BACKOFF_MAX_SEC) * 1000;
async function runSchedule(id) {
  mkdirSync5(RUNS_DIR(), { recursive: true });
  sweepStaleRuns();
  const sched = readSchedules().find((s) => s.id === id);
  if (!sched) {
    log(`run: schedule ${id} not found \u2014 skipping`);
    return 0;
  }
  if (sched.enabled === false) {
    log(`run: schedule ${id} disabled \u2014 skipping`);
    return 0;
  }
  if (readDisabled().has(id)) {
    log(`run: schedule ${id} kill-switched (agents/disabled.json) \u2014 skipping`);
    return 0;
  }
  const active = activeRunFor(id);
  if (active) {
    const msg = `concurrent run blocked \u2014 ${sched.agentTitle} run ${(active.id ?? "").slice(0, 8)} is already running (started ${new Date(active.startedAt).toISOString()})`;
    log(`run: ${msg}`);
    fileHitl({
      title: `Concurrent cron run blocked \xB7 ${sched.agentTitle}`,
      action: "previous run is still in progress; this firing was refused \u2014 investigate why the previous run is taking so long",
      detail: `active run ${active.id} \xB7 ${active.branch}`,
      repo: sched.repoLabel,
      repoRoot: sched.repoRoot,
      runId: active.id,
      runSource: "cron"
    });
    activity({
      kind: "blocked",
      title: `Concurrent cron blocked \xB7 ${sched.agentTitle}`,
      detail: `previous run ${(active.id ?? "").slice(0, 8)} still running`,
      repo: sched.repoLabel,
      repoRoot: sched.repoRoot,
      suppressTelegram: true
    });
    return 0;
  }
  const runId = randomUUID5();
  const ts = Date.now();
  const tag = `${ts}-${runId.slice(0, 4)}`;
  const repo = sched.repoRoot.startsWith("~/") ? join10(homedir2(), sched.repoRoot.slice(2)) : sched.repoRoot;
  const repoBase = repo.split("/").pop() || "repo";
  const worktree = join10(WT_DIR(), repoBase, `${id}-${tag}`);
  const branch = `cron/${sched.agentId}-${tag}`;
  const logFile = join10(RUNS_DIR(), `${runId}.log`);
  const recFile = join10(RUNS_DIR(), `${runId}.json`);
  const writeRec = (extra) => writeJsonAtomicShared(recFile, {
    id: runId,
    scheduleId: id,
    agentId: sched.agentId,
    agentTitle: sched.agentTitle,
    engine: sched.engine,
    repoRoot: repo,
    repoLabel: sched.repoLabel,
    worktree,
    branch,
    startedAt: ts,
    ...extra
  });
  log(`run ${runId}: schedule ${id} (${sched.agentTitle}) in ${repo}`);
  writeRec({ status: "running" });
  stamp(id, { lastRun: ts, lastStatus: "running", lastRunId: runId });
  activity({
    kind: "agent-run",
    title: `Scheduled \xB7 ${sched.agentTitle} \xB7 started`,
    detail: `${sched.engine} \xB7 ${sched.repoLabel}`,
    repo: sched.repoLabel,
    repoRoot: repo
  });
  const base = defaultBase(repo);
  try {
    mkdirSync5(join10(WT_DIR(), repoBase), { recursive: true });
    git(repo, ["worktree", "add", worktree, "-b", branch, base]);
  } catch (e) {
    const msg = `worktree failed: ${e}`;
    log(`run ${runId}: ${msg}`);
    writeFileSync5(logFile, msg + `
`);
    writeRec({ status: "failed", endedAt: Date.now(), error: msg });
    stamp(id, { lastStatus: "failed" });
    activity({
      kind: "tests-fail",
      title: `Scheduled \xB7 ${sched.agentTitle} \xB7 failed`,
      detail: msg.slice(0, 120),
      repo: sched.repoLabel,
      repoRoot: repo
    });
    const wtTicketPath = fileTicket(repo, {
      title: `Cron run failed: ${sched.agentTitle} (worktree setup)`,
      body: `Worktree setup failed for the scheduled \`${sched.agentTitle}\` run.

\`\`\`
${msg}
\`\`\`

- schedule: \`${id}\`
- run: \`${runId}\`
- log: \`~/.config/TerMinal/cron-runs/${runId}.log\``
    });
    fileHitl({
      title: `Scheduled run failed \xB7 ${sched.agentTitle}`,
      action: "worktree setup failed \u2014 check the repo and cron log",
      detail: msg.slice(0, 200),
      repo: sched.repoLabel,
      repoRoot: repo,
      runId,
      runSource: "cron",
      ticketPath: wtTicketPath
    });
    maybeCircuitBreak(id, sched);
    return 1;
  }
  const scriptPath = resolveScriptPath(repo, sched.agentId);
  const cmd = buildCommand(sched, worktree, scriptPath);
  const isMac = process.platform === "darwin";
  const shell = shellFor(isMac);
  writeFileSync5(logFile, `\u25B8 ${sched.agentTitle} \xB7 ${sched.engine}
\u25B8 branch ${branch}
\u25B8 ${scriptPath ? `exec ${scriptPath}` : cmd}

`);
  const fd = openSync2(logFile, "a");
  const childEnv = buildChildEnv({ sched, repo, runId, branch, worktree });
  const maxRetries = Math.max(0, Number(sched.retry?.maxRetries ?? DEFAULT_RETRY_MAX));
  const backoffBaseSec = Math.max(1, Number(sched.retry?.backoffSec ?? BACKOFF_BASE_SEC));
  const timeoutMs = sched.timeoutSec && sched.timeoutSec > 0 ? sched.timeoutSec * 1000 : DEFAULT_TIMEOUT_MS;
  let currentChild = null;
  let canceling = false;
  const onCancelSignal = () => {
    if (canceling)
      return;
    canceling = true;
    try {
      if (currentChild && currentChild.pid)
        process.kill(-currentChild.pid, "SIGTERM");
    } catch {}
    try {
      writeRec({ status: "canceled", endedAt: Date.now(), error: "canceled by user" });
    } catch {}
    process.exit(0);
  };
  process.on("SIGTERM", onCancelSignal);
  process.on("SIGINT", onCancelSignal);
  const runAttempt = (attempts2) => new Promise((resolve) => {
    const p = spawn3("script", scriptArgsFor(isMac, shell, cmd), {
      cwd: worktree,
      env: childEnv,
      stdio: ["ignore", fd, fd],
      detached: true
    });
    currentChild = p;
    if (p.pid)
      writeRec({ status: "running", pid: p.pid, runnerPid: process.pid, attempts: attempts2 });
    let timedOut2 = false;
    const killGroup = (sig) => {
      try {
        if (p.pid)
          process.kill(-p.pid, sig);
      } catch {}
    };
    const timer = setTimeout(() => {
      timedOut2 = true;
      appendFileSync2(logFile, `
[timeout] attempt exceeded ${Math.round(timeoutMs / 1000)}s \u2014 killing run
`);
      killGroup("SIGTERM");
      setTimeout(() => killGroup("SIGKILL"), 5000);
    }, timeoutMs);
    p.on("error", (err) => {
      clearTimeout(timer);
      appendFileSync2(logFile, `
[spawn error] ${err.message}
`);
      resolve({ code: 1, timedOut: timedOut2 });
    });
    p.on("exit", (c) => {
      clearTimeout(timer);
      resolve({ code: timedOut2 ? TIMEOUT_EXIT : c ?? 1, timedOut: timedOut2 });
    });
  });
  let code = 1;
  let timedOut = false;
  let attempts = 0;
  for (let attempt = 0;attempt <= maxRetries; attempt++) {
    if (attempt > 0) {
      const waitMs = backoffMsFor(attempt - 1, backoffBaseSec);
      appendFileSync2(logFile, `
\u25B8 attempt ${attempt} failed (exit ${code}${timedOut ? ", timed out" : ""}) \u2014 retry ${attempt}/${maxRetries} in ${Math.round(waitMs / 1000)}s
`);
      stamp(id, { lastStatus: "running" });
      await sleep(waitMs);
      try {
        git(worktree, ["reset", "--hard", base]);
        git(worktree, ["clean", "-fd"]);
      } catch (e) {
        appendFileSync2(logFile, `[retry] worktree reset failed: ${e}
`);
      }
      appendFileSync2(logFile, `
\u25B8 attempt ${attempt + 1}/${maxRetries + 1}
`);
    }
    attempts = attempt + 1;
    const res = await runAttempt(attempts);
    code = res.code;
    timedOut = res.timedOut;
    if (code === 0)
      break;
  }
  const status = code === 0 ? "done" : "failed";
  const endedAt = Date.now();
  writeRec({ status, endedAt, exitCode: code, attempts, ...timedOut ? { timedOut: true } : {} });
  stamp(id, { lastStatus: status });
  try {
    const logText = readFileSync4(logFile, "utf8");
    const usage = sched.engine === "cursor" ? null : parseUsageFromOutput(logText);
    if (usage) {
      writeAIRun({
        engine: sched.engine,
        model: usage.model || childEnv.TERMINAL_MODEL || (sched.engine === "codex" ? "gpt-5" : sched.engine === "cursor" ? "cursor" : "sonnet"),
        inputTokens: usage.input,
        outputTokens: usage.output,
        cacheReadTokens: usage.cacheRead,
        repoRoot: repo,
        runId,
        agentId: sched.agentId,
        startedAt: ts,
        endedAt,
        exitCode: code
      });
    }
  } catch {}
  const attemptNote = attempts > 1 ? ` \xB7 ${attempts} attempts` : "";
  activity({
    kind: code === 0 ? "agent-run" : "tests-fail",
    title: `Scheduled \xB7 ${sched.agentTitle} \xB7 ${status}`,
    detail: `${sched.engine} \xB7 ${branch}${attemptNote}${code === 0 && attempts > 1 ? " (recovered on retry)" : ""}`,
    repo: sched.repoLabel,
    repoRoot: repo
  });
  if (code !== 0) {
    const failReason = timedOut ? `timed out after ${Math.round(timeoutMs / 1000)}s` : `exited with code ${code}`;
    const failTicketPath = fileTicket(repo, {
      title: `Cron run failed: ${sched.agentTitle} (${timedOut ? "timeout" : `exit ${code}`})`,
      body: `The scheduled \`${sched.agentTitle}\` run ${failReason} after ${attempts} attempt${attempts === 1 ? "" : "s"}.

- schedule: \`${id}\`
- run: \`${runId}\`
- branch: \`${branch}\`
- worktree: \`${worktree}\`
- log: \`~/.config/TerMinal/cron-runs/${runId}.log\`

Investigate the log and fix the underlying issue; circuit-breaker auto-disables after ${CIRCUIT_BREAK_AFTER} consecutive failures.`
    });
    fileHitl({
      title: `Scheduled run failed \xB7 ${sched.agentTitle}`,
      action: `${failReason} after ${attempts} attempt${attempts === 1 ? "" : "s"} \u2014 review the run log`,
      detail: `run ${runId} \xB7 ${branch}`,
      repo: sched.repoLabel,
      repoRoot: repo,
      runId,
      runSource: "cron",
      ticketPath: failTicketPath
    });
    maybeCircuitBreak(id, sched);
  }
  log(`run ${runId}: ${status} (exit ${code}, ${attempts} attempt${attempts === 1 ? "" : "s"}${timedOut ? ", timed out" : ""})`);
  return code === 0 ? 0 : 1;
}

// src/runner/cron-match.ts
function parseCronFieldLocal(field, min, max) {
  if (field === "*")
    return null;
  const out = new Set;
  for (const part of field.split(",")) {
    const m = part.match(/^(\*|\d+(?:-\d+)?)(?:\/(\d+))?$/);
    if (!m)
      return null;
    const [, range, stepRaw] = m;
    const step = stepRaw ? Number(stepRaw) : 1;
    if (step < 1)
      return null;
    let lo, hi;
    if (range === "*") {
      lo = min;
      hi = max;
    } else if (range.includes("-")) {
      const [a, b] = range.split("-").map(Number);
      lo = a;
      hi = b;
    } else {
      lo = hi = Number(range);
    }
    if (lo < min || hi > max || lo > hi)
      return null;
    for (let v = lo;v <= hi; v += step)
      out.add(v);
  }
  return [...out];
}
function specEntriesLocal(spec) {
  if (!spec)
    return null;
  if (spec.kind === "cron") {
    const fields = String(spec.expr || "").trim().split(/\s+/);
    if (fields.length !== 5)
      return null;
    const [minF, hourF, domF, monF, dowF] = fields;
    const dows = parseCronFieldLocal(dowF, 0, 7)?.map((d) => d === 7 ? 0 : d);
    return {
      minutes: parseCronFieldLocal(minF, 0, 59),
      hours: parseCronFieldLocal(hourF, 0, 23),
      days: parseCronFieldLocal(domF, 1, 31),
      months: parseCronFieldLocal(monF, 1, 12),
      dows: dows ? [...new Set(dows)] : null
    };
  }
  if (spec.kind === "calendar") {
    return {
      minutes: [spec.minute || 0],
      hours: [spec.hour || 0],
      days: null,
      months: null,
      dows: spec.weekdays && spec.weekdays.length ? spec.weekdays : null
    };
  }
  return null;
}
function matchesEntriesLocal(e, d) {
  return (e.minutes === null || e.minutes.includes(d.getMinutes())) && (e.hours === null || e.hours.includes(d.getHours())) && (e.days === null || e.days.includes(d.getDate())) && (e.dows === null || e.dows.includes(d.getDay())) && (e.months === null || e.months.includes(d.getMonth() + 1));
}
var CADENCE_SCAN_DAYS = 45;
function prevExpectedFire(spec, from) {
  const e = specEntriesLocal(spec);
  if (!e)
    return null;
  const d = new Date(from);
  d.setSeconds(0, 0);
  for (let i = 0;i < CADENCE_SCAN_DAYS * 24 * 60; i++) {
    if (matchesEntriesLocal(e, d))
      return d.getTime();
    d.setMinutes(d.getMinutes() - 1);
  }
  return null;
}

// src/runner/watchdog.ts
function openOverdueHitlIds() {
  const list = readJson(HITL_FILE());
  if (!Array.isArray(list))
    return new Set;
  const ids = new Set;
  for (const h of list)
    if (h.status === "open" && h.overdueScheduleId)
      ids.add(h.overdueScheduleId);
  return ids;
}
function watchdogCadenceCheck() {
  const schedules = readSchedules();
  const disabled = readDisabled();
  const openOverdue = openOverdueHitlIds();
  let overdue = 0;
  const now = Date.now();
  for (const s of schedules) {
    if (!s.enabled)
      continue;
    if (disabled.has(s.id))
      continue;
    if (!s.lastRun)
      continue;
    const prev = prevExpectedFire(s.spec, now);
    if (!prev)
      continue;
    const prev2 = prevExpectedFire(s.spec, prev - 60000);
    if (!prev2)
      continue;
    if (s.lastRun >= prev2)
      continue;
    overdue++;
    if (openOverdue.has(s.id))
      continue;
    const mins = Math.round((now - s.lastRun) / 60000);
    fileHitl({
      overdueScheduleId: s.id,
      title: `Schedule overdue \xB7 ${s.agentTitle}`,
      action: `missed its last 2 expected fires \u2014 last ran ${mins} min ago. Check the launchd plist / re-enable from the Schedules tab.`,
      detail: `schedule ${s.id} \xB7 ${s.repoLabel}`,
      repo: s.repoLabel,
      repoRoot: s.repoRoot
    });
    activity({
      kind: "blocked",
      title: `Schedule overdue \xB7 ${s.agentTitle}`,
      detail: `${mins} min since last run`,
      repo: s.repoLabel,
      repoRoot: s.repoRoot,
      suppressTelegram: true
    });
    log(`watchdog: schedule ${s.id} (${s.agentTitle}) overdue \u2014 last ran ${mins} min ago`);
  }
  return overdue;
}
async function runWatchdog() {
  log("watchdog: tick");
  const swept = sweepStaleRuns();
  const overdue = watchdogCadenceCheck();
  log(`watchdog: swept=${swept} overdue=${overdue}`);
  activity({
    kind: "check",
    title: `Watchdog \xB7 swept ${swept} stale \xB7 ${overdue} overdue`,
    detail: "fleet heartbeat"
  });
  try {
    await maybeRunReviewPatterns();
  } catch (e) {
    log(`review-patterns piggyback failed: ${e}`);
  }
  try {
    await maybeRunRetention();
  } catch (e) {
    log(`retention piggyback failed: ${e}`);
  }
  return 0;
}

// src/runner/index.ts
function die(what) {
  return (e) => {
    console.error(`terminal-cron: ${what} failed: ${e?.stack || e}`);
    process.exit(1);
  };
}
function main(argv) {
  const [, , action, arg] = argv;
  if (action === "run" && arg) {
    runSchedule(arg).then((c) => process.exit(c)).catch(die(`run ${arg}`));
  } else if (action === "watchdog") {
    runWatchdog().then((c) => process.exit(c)).catch(die("watchdog"));
  } else if (action === "review-patterns") {
    maybeRunReviewPatterns(arg === "--force").then(() => process.exit(0)).catch(die("review-patterns"));
  } else if (action === "retention") {
    maybeRunRetention(true).then((r) => {
      console.log(JSON.stringify(r));
      process.exit(0);
    }).catch(die("retention"));
  } else {
    console.error("usage: terminal-cron run <scheduleId>");
    console.error("       terminal-cron watchdog");
    console.error("       terminal-cron review-patterns [--force]");
    console.error("       terminal-cron retention");
    process.exit(2);
  }
}
main(process.argv);
export {
  main
};
