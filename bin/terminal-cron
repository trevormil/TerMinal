// src/runner/settings.ts
function settings() {
  return readJson(SETTINGS_FILE());
}
function tgCreds() {
  const pick = (o) => {
    const bt = o?.botToken;
    const ci = o?.chatId;
    return typeof bt === "string" && bt && typeof ci === "string" && ci ? { botToken: bt, chatId: ci } : null;
  };
  const sc = readJson(TG_SIDECAR());
  const st = settings()?.telegram ?? null;
  return pick(sc) ?? pick(st);
}
function engineDefaultModel(engine) {
  return (settings()?.engines?.[engine]?.defaultModel || "").trim();
}
var ENGINE_EFFORTS = {
  claude: ["low", "medium", "high", "xhigh", "max"],
  codex: ["minimal", "low", "medium", "high", "xhigh"],
  pi: ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
  opencode: ["minimal", "low", "medium", "high", "max"],
  openrouter: ["minimal", "low", "medium", "high", "xhigh"],
  "openai-compat": ["minimal", "low", "medium", "high", "xhigh"]
};
function engineDefaultEffort(engine) {
  return (settings()?.engines?.[engine]?.defaultEffort || "").trim();
}
function resolveEffort(sched) {
  const level = (sched.effort || "").trim() || engineDefaultEffort(sched.engine);
  return (ENGINE_EFFORTS[sched.engine] || []).includes(level) ? level : "";
}
function effortFlag(sched) {
  const level = resolveEffort(sched);
  if (!level)
    return "";
  if (sched.engine === "claude")
    return ` --effort ${level}`;
  if (sched.engine === "pi")
    return ` --thinking ${level}`;
  if (sched.engine === "opencode")
    return ` --variant ${level}`;
  if (sched.engine === "openrouter" || sched.engine === "openai-compat")
    return ` --effort ${level}`;
  return ` -c model_reasoning_effort=${level}`;
}
function openAICompatBaseUrl() {
  return (settings()?.engines?.["openai-compat"]?.baseUrl || "").trim();
}
function inboxNotifyThreshold() {
  return settings()?.inbox?.notifyThreshold;
}
function harnessDir() {
  if (process.env.GT_HARNESS_DIR)
    return process.env.GT_HARNESS_DIR;
  return settings()?.harnessDir || "";
}

// src/runner/slack.ts
function slackCfg() {
  const c = readJson(SLACK_SIDECAR());
  return typeof c?.botToken === "string" && c.botToken ? c : null;
}
function slackQuietsTelegram() {
  return slackCfg()?.destination === "slack";
}
function slackSlug(raw) {
  return String(raw || "").toLowerCase().replace(/[/\s]+/g, "-").replace(/[^a-z0-9_-]+/g, "").replace(/-+/g, "-").replace(/^-|-$/g, "");
}
function slackChannelFor(category, cfg) {
  const fallback = slackSlug(cfg.defaultChannel).slice(0, 80) || "terminal-inbox";
  const slug = category && category !== "Uncategorized" ? slackSlug(category) : "";
  if (!slug)
    return fallback;
  const prefix = slackSlug(cfg.channelPrefix);
  return (prefix ? `${prefix}-${slug}` : slug).slice(0, 80);
}
function slackApi(token, method, body) {
  return fetch(`https://slack.com/api/${method}`, {
    method: "POST",
    headers: {
      authorization: `Bearer ${token}`,
      "content-type": "application/json; charset=utf-8"
    },
    body: JSON.stringify(body),
    signal: AbortSignal.timeout(8000)
  }).then((r) => r.json());
}
function mirrorHitlToSlack(item) {
  const cfg = slackCfg();
  if (!cfg)
    return;
  (async () => {
    const channel = slackChannelFor(item.category, cfg);
    const fallback = slackChannelFor(undefined, cfg);
    const marker = item.source === "completion-hook" ? "\u2705" : "\u26D4";
    const text = `${marker} ${item.title}${item.action ? ` \u2014 ${item.action}` : ""}`;
    const post = (to) => slackApi(cfg.botToken, "chat.postMessage", { channel: to, text });
    let res = await post(`#${channel}`);
    if (!res?.ok && res?.error === "channel_not_found" && cfg.autoCreateChannels) {
      const created = await slackApi(cfg.botToken, "conversations.create", { name: channel });
      const createdId = created?.channel && typeof created.channel === "object" ? created.channel.id : undefined;
      if (created?.ok && createdId) {
        if (cfg.inviteUserId)
          await slackApi(cfg.botToken, "conversations.invite", {
            channel: createdId,
            users: cfg.inviteUserId
          }).catch(() => {
            return;
          });
        res = await post(createdId);
      }
    }
    if (!res?.ok && channel !== fallback)
      res = await post(`#${fallback}`);
    if (res?.ok && typeof res.channel === "string" && typeof res.ts === "string") {
      const slackChannel = res.channel;
      const slackTs = res.ts;
      updateJsonListShared(HITL_FILE(), (list) => list.map((h) => h.id === item.id ? { ...h, slackChannel, slackTs } : h));
    }
  })().catch(() => {});
}

// src/runner/hitl.ts
var SEVERITY_RANK = { urgent: 3, normal: 2, low: 1 };
function hitlIsLoud(severity) {
  if (!severity || !SEVERITY_RANK[severity])
    return true;
  const threshold = inboxNotifyThreshold();
  return SEVERITY_RANK[severity] >= (SEVERITY_RANK[threshold ?? ""] || 3);
}
function fileHitl(item) {
  const rec = {
    id: randomUUID3(),
    status: "open",
    createdAt: Date.now(),
    source: "cron-fail",
    ...item
  };
  try {
    updateJsonListShared(HITL_FILE(), (list) => [rec, ...list]);
  } catch (e) {
    log(`hitl write failed: ${e}`);
  }
  mirrorHitlToSlack(rec);
  if (!hitlIsLoud(rec.severity) || slackQuietsTelegram())
    return rec;
  try {
    const text = `\u26D4 Inbox \xB7 ${rec.title}${rec.action ? ` \u2014 ${rec.action}` : ""}`;
    const t = tgCreds();
    if (t) {
      const row = [{ text: "\u2705 Resolve", callback_data: `hitl:resolve:${rec.id}` }];
      if (rec.runId)
        row.push({ text: "\uD83E\uDEB5 Tail run", callback_data: `run:tail:${rec.runId}` });
      fetch(`https://api.telegram.org/bot${t.botToken}/sendMessage`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          chat_id: t.chatId,
          text,
          reply_markup: { inline_keyboard: [row] }
        }),
        signal: AbortSignal.timeout(8000)
      }).catch(() => {});
    } else if (existsSync(LEGACY_TG_SCRIPT())) {
      try {
        const child = spawn(LEGACY_TG_SCRIPT(), ["--kind=blocked", text], { stdio: "ignore" });
        child.on("error", () => {});
        child.unref();
      } catch {}
    }
  } catch {}
  return rec;
}

// src/runner/review-patterns.ts
var REVIEW_PATTERNS_INTERVAL_MS = 7 * 24 * 60 * 60 * 1000;
var REVIEW_PROMOTE_COUNT = 3;
var REVIEW_PROMOTE_REPOS = 2;
async function maybeRunReviewPatterns(force = false) {
  if (!force) {
    const m = readJson(REVIEW_PATTERNS_MARKER());
    if (m?.lastRunAt && Date.now() - m.lastRunAt < REVIEW_PATTERNS_INTERVAL_MS)
      return;
  }
  await runReviewPatterns();
}
async function runReviewPatterns() {
  const dir = harnessDir();
  if (!dir) {
    log("review-patterns: no harnessDir configured, skipping");
    return 0;
  }
  const bin = join3(dir, "bin", "review-findings-mine");
  if (!existsSync2(bin)) {
    log(`review-patterns: ${bin} missing, skipping`);
    return 0;
  }
  log(`review-patterns: mining via ${bin}`);
  const out = await new Promise((resolve, reject) => {
    const proc = spawn2(bin, [
      "--json",
      "--threshold-count",
      String(REVIEW_PROMOTE_COUNT),
      "--threshold-repos",
      String(REVIEW_PROMOTE_REPOS)
    ], {
      cwd: dir,
      stdio: ["ignore", "pipe", "pipe"]
    });
    let stdout = "";
    let stderr = "";
    proc.stdout.on("data", (d) => stdout += d.toString());
    proc.stderr.on("data", (d) => stderr += d.toString());
    proc.on("exit", (code) => code === 0 ? resolve(stdout) : reject(new Error(`exit ${code}: ${stderr}`)));
  });
  let parsed;
  try {
    parsed = JSON.parse(out);
  } catch (e) {
    log(`review-patterns: parse failed: ${e}`);
    return 0;
  }
  const promote = parsed.promote || [];
  const existingKeys = openReviewPatternHitlKeys();
  let filed = 0;
  for (const p of promote) {
    if (existingKeys.has(p.key))
      continue;
    fileHitl({
      kind: "review-pattern",
      source: "review-pattern",
      severity: "normal",
      patternKey: p.key,
      title: `Recurring ${p.category} finding: ${p.tokens.join(" / ")}`,
      action: `${p.count}\xD7 across ${p.repos.length} repos \u2014 promote to CLAUDE.md?`,
      detail: `repos: ${p.repos.join(", ")}

Examples:
` + (p.examples || []).map((e) => `- ${e.repo}#${e.pr} "${e.title}"${e.file ? ` \u2014 ${e.file}` : ""}`).join(`
`)
    });
    filed++;
  }
  activity({
    kind: "check",
    title: `Review patterns \xB7 ${parsed.totals?.total || 0} findings \xB7 ${promote.length} promote candidates \xB7 ${filed} HITL filed`,
    detail: `report: ${join3(dir, "reports", "review-patterns.md")}`
  });
  try {
    writeFileSync3(REVIEW_PATTERNS_MARKER(), JSON.stringify({ lastRunAt: Date.now(), filed, promote: promote.length }, null, 2));
  } catch {}
  log(`review-patterns: promote=${promote.length} filed=${filed}`);
  return 0;
}
function openReviewPatternHitlKeys() {
  const list = readJson(HITL_FILE());
  if (!Array.isArray(list))
    return new Set;
  const keys = new Set;
  for (const h of list) {
    if (h.kind === "review-pattern" && h.status === "open" && h.patternKey)
      keys.add(h.patternKey);
  }
  return keys;
}

