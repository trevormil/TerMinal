#!/usr/bin/env bun
// terminal-monitor — the Monitoring daemon. A dedicated process (its own
// launchd job com.terminal.monitor, NOT terminal-cron) that probes registered
// monitors and files Inbox items on transitions. Pure, deterministic
// infrastructure observability: zero inference, no agents, no LLM.
//
//   terminal-monitor tick          run every monitor that is due (launchd fires this)
//   terminal-monitor run <id>      run one monitor now, regardless of schedule
//   terminal-monitor digest        file the daily digest for monitors that want it
//
// SELF-CONTAINED: no imports from the app bundle. The classifiers mirror
// src/main/monitors.ts (keep in sync — they're tiny pure functions).

import {
  readFileSync,
  writeFileSync,
  existsSync,
  mkdirSync,
  readdirSync,
  renameSync,
  unlinkSync,
  rmSync,
} from 'node:fs'
import { join } from 'node:path'
import { homedir } from 'node:os'
import { execFileSync, spawnSync } from 'node:child_process'
import { connect as tlsConnect } from 'node:tls'
import { connect as netConnect } from 'node:net'
import { resolve as dnsResolve } from 'node:dns/promises'

// Single resolution point for the config dir, honouring TERMINAL_CONFIG_DIR the
// same way src/main/config-dir.ts does. These are SEPARATE PROCESSES writing the
// same files as the app, so a sandboxed run that only redirected the app would
// still have this script clobbering real state — which is precisely how an agent
// script would do it (ticket 108). Eager is fine here and not in the app: each
// invocation is a fresh short-lived process that reads the env at startup.
const CFG =
  process.env.TERMINAL_CONFIG_DIR?.trim() || join(homedir(), '.config', 'TerMinal')
const MONITORS_FILE = join(CFG, 'monitors.json')
const STATE_DIR = join(CFG, 'monitor-state')
const CLI = join(CFG, 'bin', 'terminal-cli')
const LOG = join(CFG, 'monitor.log')

function log(msg) {
  try {
    writeFileSync(LOG, `${new Date().toISOString()} ${msg}\n`, { flag: 'a' })
  } catch {}
}

function readMonitors() {
  try {
    const raw = JSON.parse(readFileSync(MONITORS_FILE, 'utf8'))
    return Array.isArray(raw) ? raw.filter((m) => m && typeof m.id === 'string') : []
  } catch {
    return []
  }
}
function readState(id) {
  try {
    return JSON.parse(readFileSync(join(STATE_DIR, `${id}.json`), 'utf8'))
  } catch {
    return null
  }
}
// Temp + rename: a plain write truncates first, so a kill mid-write leaves a
// state file the daemon can no longer parse and the monitor silently resets.
function writeState(id, state) {
  mkdirSync(STATE_DIR, { recursive: true })
  const file = join(STATE_DIR, `${id}.json`)
  const tmp = `${file}.${process.pid}.tmp`
  try {
    writeFileSync(tmp, `${JSON.stringify(state, null, 2)}\n`)
    renameSync(tmp, file)
  } catch (e) {
    try {
      unlinkSync(tmp)
    } catch {}
    log(`state write failed for ${id}: ${e}`)
  }
}

// ---- classifiers (mirror src/main/monitors.ts) -----------------------------
// Chain validity folded into expiry health. `warn`, not `fail`: an untrusted
// chain is often deliberate (internal CA, staging box), and a monitor that hard
// -fails on it gets muted — after which it detects nothing. A bad chain is
// simply never allowed to read as `ok`. Canonical impl + tests:
// src/main/monitors.ts:classifyCertTrust — keep in sync.
function classifyCertTrust(expiryState, authorized) {
  if (authorized) return expiryState
  return expiryState === 'ok' ? 'warn' : expiryState
}
function classifyHttp(status, latencyMs, warnLatencyMs) {
  if (status === null || status >= 500) return 'fail'
  if (status >= 400) return 'warn'
  if (warnLatencyMs && latencyMs !== null && latencyMs > warnLatencyMs) return 'warn'
  return 'ok'
}
function classifyCert(days, warnDays = 15, critDays = 5) {
  if (days === null) return 'fail'
  if (days < 0 || days <= critDays) return 'fail'
  if (days <= warnDays) return 'warn'
  return 'ok'
}

// ---- probes ----------------------------------------------------------------
async function probeHttp(m) {
  const warnLatency = Number(m.config?.warnLatencyMs) || undefined
  const t0 = Date.now()
  let status = null
  try {
    const res = await fetch(m.target, {
      method: m.config?.method || 'GET',
      redirect: 'manual',
      signal: AbortSignal.timeout(Number(m.config?.timeoutMs) || 10000),
      headers: { 'user-agent': 'terminal-monitor/1.0' },
    })
    status = res.status
    const needle = m.config?.bodyContains
    if (needle) {
      const body = await res.text()
      if (!body.includes(String(needle)))
        return { status: 'fail', summary: `body missing "${needle}"`, metrics: { http: status } }
    }
  } catch {
    status = null
  }
  const latencyMs = Date.now() - t0
  const state = classifyHttp(status, latencyMs, warnLatency)
  const summary = status === null ? 'no response' : `HTTP ${status} · ${latencyMs}ms`
  return { status: state, summary, metrics: { http: status ?? 0, latencyMs } }
}

function probeTls(m) {
  const [host, portStr] = String(m.target).split(':')
  const port = Number(portStr) || 443
  return new Promise((resolve) => {
    const socket = tlsConnect(
      { host, port, servername: host, rejectUnauthorized: false, timeout: 10000 },
      () => {
        const cert = socket.getPeerCertificate()
        // rejectUnauthorized stays false ON PURPOSE — you want to be told a cert
        // expires in 3 days even when the chain is already broken, and a
        // rejected handshake reports nothing at all. But the trust result was
        // then THROWN AWAY, so a self-signed / wrong-hostname / untrusted-issuer
        // cert rendered as a plain green "88d until expiry" (ticket 67 F-15).
        const authorized = socket.authorized === true
        const authError = socket.authorizationError ? String(socket.authorizationError) : ''
        socket.end()
        if (!cert || !cert.valid_to)
          return resolve({ status: 'fail', summary: 'no certificate' })
        const days = Math.floor((new Date(cert.valid_to).getTime() - Date.now()) / 86400000)
        const expiry = classifyCert(days, Number(m.config?.warnDays) || 15, Number(m.config?.critDays) || 5)
        const state = classifyCertTrust(expiry, authorized)
        const issuer = cert.issuer?.O || 'issuer ?'
        resolve({
          status: state,
          summary: authorized
            ? `${days}d until expiry · ${issuer}`
            : `${days}d until expiry · ${issuer} · UNTRUSTED CHAIN (${authError || 'not authorized'})`,
          metrics: {
            daysRemaining: days,
            notAfter: cert.valid_to,
            authorized,
            authorizationError: authError,
          },
        })
      },
    )
    socket.on('error', () => resolve({ status: 'fail', summary: 'TLS handshake failed' }))
    socket.on('timeout', () => {
      socket.destroy()
      resolve({ status: 'fail', summary: 'TLS timeout' })
    })
  })
}

function probeTcp(m) {
  const [host, portStr] = String(m.target).split(':')
  const port = Number(portStr)
  return new Promise((resolve) => {
    const t0 = Date.now()
    const socket = netConnect({ host, port, timeout: 8000 }, () => {
      socket.end()
      resolve({ status: 'ok', summary: `port ${port} open · ${Date.now() - t0}ms`, metrics: { latencyMs: Date.now() - t0 } })
    })
    socket.on('error', () => resolve({ status: 'fail', summary: `port ${port} closed/unreachable` }))
    socket.on('timeout', () => {
      socket.destroy()
      resolve({ status: 'fail', summary: `port ${port} timeout` })
    })
  })
}

async function probeDns(m) {
  try {
    const recs = await dnsResolve(m.target, m.config?.recordType || 'A')
    const expect = m.config?.expect
    if (expect && !recs.flat().map(String).includes(String(expect)))
      return { status: 'fail', summary: `no ${m.config?.recordType || 'A'} record = ${expect}`, metrics: { records: recs.length } }
    return { status: 'ok', summary: `${recs.length} record(s)`, metrics: { records: recs.length } }
  } catch {
    return { status: 'fail', summary: 'DNS resolution failed' }
  }
}

function probeCommand(m) {
  const r = spawnSync('/bin/bash', ['-lc', m.target], {
    encoding: 'utf8',
    timeout: Number(m.config?.timeoutMs) || 30000,
    maxBuffer: 4 * 1024 * 1024,
  })
  const out = (r.stdout || '').trim()
  let parsed = null
  try {
    const j = JSON.parse(out.split('\n').pop() || '')
    if (j && typeof j === 'object') parsed = j
  } catch {}
  const status =
    parsed?.status === 'ok' || parsed?.status === 'warn' || parsed?.status === 'fail'
      ? parsed.status
      : r.status === 0
        ? 'ok'
        : 'fail'
  const summary = parsed?.summary || out.split('\n').slice(-1)[0] || (r.status === 0 ? 'exit 0' : `exit ${r.status}`)
  return {
    status,
    summary: String(summary).slice(0, 200),
    metrics: parsed?.metrics || { exitCode: r.status ?? -1 },
    detail: parsed?.detail,
  }
}

async function probe(m) {
  switch (m.type) {
    case 'http':
      return probeHttp(m)
    case 'tls-cert':
      return probeTls(m)
    case 'tcp':
      return probeTcp(m)
    case 'dns':
      return probeDns(m)
    case 'command':
      return probeCommand(m)
    default:
      return { status: 'fail', summary: `unknown type ${m.type}` }
  }
}

// ---- inbox filing (via terminal-cli — reuses severity + telegram) ----------
function fileInbox(title, action, severity) {
  if (!existsSync(CLI)) return
  try {
    execFileSync(CLI, ['hitl', title, action, `--severity=${severity}`], {
      stdio: 'ignore',
      timeout: 15000,
      env: { ...process.env, TERMINAL_REPO: '' },
    })
  } catch {}
}

// ---- human, email-like notification copy -----------------------------------
// "meridian.trevormil.com is down — the uptime check returned HTTP 503" reads
// like mail; "Monitor fail · meridian / HTTP 503" reads like a log line. The
// inbox is where you triage from your phone, so it gets the friendly version.
const KIND = {
  http: 'uptime check',
  'tls-cert': 'TLS certificate',
  tcp: 'port check',
  dns: 'DNS lookup',
  command: 'health check',
}

function humanSince(since, now) {
  const s = Math.max(0, Math.round((now - since) / 1000))
  if (s < 60) return 'just now'
  if (s < 3600) return `${Math.round(s / 60)} min ago`
  if (s < 86400) return `${Math.round(s / 3600)} hr ago`
  return `${Math.round(s / 86400)} days ago`
}

function compose(m, prevStatus, next, res, now, since) {
  const kind = KIND[m.type] || 'check'
  const summary = (res.summary || '').trim()
  // The concrete thing being watched — a URL/host for network checks; a command
  // has no meaningful target to show.
  const where = m.target && m.type !== 'command' ? ` at ${m.target}` : ''

  if (next === 'ok') {
    const wasWord = prevStatus === 'fail' ? 'failing' : 'degraded'
    return {
      title: `✅ ${m.name} recovered`,
      body:
        `Good news — ${m.name} is healthy again after ${wasWord}. ` +
        `Its ${kind}${where} is passing once more${summary ? ` (${summary})` : ''}.`,
    }
  }

  // Type-aware subject so a cert warning doesn't read as "is down".
  let title
  if (m.type === 'tls-cert') {
    title = next === 'fail' ? `🔴 ${m.name} certificate problem` : `🟡 ${m.name} certificate expiring`
  } else if (m.type === 'command') {
    title = next === 'fail' ? `🔴 ${m.name} check failed` : `🟡 ${m.name} check degraded`
  } else {
    title = next === 'fail' ? `🔴 ${m.name} is down` : `🟡 ${m.name} is degraded`
  }

  const priorLine =
    prevStatus === 'ok'
      ? 'It was healthy on the previous check.'
      : `It had already been ${prevStatus} before this.`
  const verb = next === 'fail' ? 'started failing' : 'started reporting problems'
  return {
    title,
    body:
      `${m.name}'s ${kind}${where} ${verb} ${humanSince(since, now)}. ` +
      `${summary ? `What we saw: ${summary}. ` : ''}${priorLine}`,
  }
}

// ---- run one monitor -------------------------------------------------------
// Mirrors src/main/monitors.ts:needsConfirmation — keep in sync. A probe that
// would move a monitor to a WORSE state gets one confirmation re-probe before
// the transition is believed: a single timed-out fetch (laptop sleep/wake,
// Wi-Fi blip) otherwise files an urgent "is down" plus a recovery minutes
// later. A real outage fails the confirm probe too and still alerts on this
// same tick.
const RANK = { ok: 0, warn: 1, fail: 2 }
function needsConfirmation(prev, next) {
  return RANK[next] > RANK[prev]
}

async function runOne(m, now) {
  const prev = readState(m.id)
  let res = await probe(m)
  const prevStatus = prev && ['ok', 'warn', 'fail'].includes(prev.status) ? prev.status : 'ok'
  if (needsConfirmation(prevStatus, res.status)) {
    const raw = Number(m.config?.confirmDelayMs)
    const delayMs = Number.isFinite(raw) && raw >= 0 ? raw : 5000
    if (delayMs) await new Promise((r) => setTimeout(r, delayMs))
    res = await probe(m)
  }
  const next = res.status
  const changed = prevStatus !== next
  const notify = m.notify || {}

  const state = {
    id: m.id,
    status: next,
    summary: res.summary || '',
    metrics: res.metrics,
    detail: res.detail,
    lastCheckedAt: now,
    since: changed ? now : prev?.since || now,
    lastTransition: changed ? { from: prevStatus, to: next, at: now } : prev?.lastTransition || null,
    history: [{ at: now, status: next }, ...(Array.isArray(prev?.history) ? prev.history : [])].slice(0, 100),
  }
  writeState(m.id, state)

  // Notify on transition, or re-nag a still-failing check after its window.
  const renotifySec = Number(notify.renotifyAfterSec) || 0
  const lastAlertAt = prev?.lastTransition?.at ?? prev?.since ?? now
  const dueRenotify = !changed && next !== 'ok' && renotifySec && now - lastAlertAt >= renotifySec * 1000
  if (changed || dueRenotify) {
    if (next === 'ok' && notify.onRecovery !== false) {
      const { title, body } = compose(m, prevStatus, next, res, now, state.since)
      fileInbox(title, body, 'low')
    } else if (next !== 'ok') {
      const sev = notify.onFailure && notify.onFailure !== 'off' ? notify.onFailure : 'urgent'
      if (notify.onFailure !== 'off') {
        const { title, body } = compose(m, prevStatus, next, res, now, state.since)
        fileInbox(title, body, sev)
      }
    }
  }
  log(`run ${m.id} (${m.type}) ${prevStatus}→${next}${changed ? ' *' : ''}`)
  return state
}

// ---- entrypoints -----------------------------------------------------------
async function tick() {
  // Prune orphaned state (monitor deleted).
  const ids = new Set(readMonitors().map((m) => m.id))
  try {
    for (const f of readdirSync(STATE_DIR))
      if (f.endsWith('.json') && !ids.has(f.slice(0, -5))) rmSync(join(STATE_DIR, f))
  } catch {}

  const now = Date.now()
  for (const m of readMonitors()) {
    if (m.enabled === false) continue
    const prev = readState(m.id)
    const dueAt = (prev?.lastCheckedAt || 0) + (Number(m.intervalSec) || 60) * 1000
    if (now >= dueAt) await runOne(m, now)
  }
}

async function digest() {
  const now = new Date()
  for (const m of readMonitors()) {
    if (!m.notify?.dailyDigest) continue
    if (now.getHours() !== (Number(m.notify.digestHour) || 9)) continue
    const st = readState(m.id)
    const status = st?.status || 'unknown'
    const mood = status === 'ok' ? 'looking healthy' : status === 'warn' ? 'a little degraded' : 'having trouble'
    fileInbox(
      `☀️ Daily check-in · ${m.name}`,
      `Your ${KIND[m.type] || 'monitor'} for ${m.name} is ${mood} today${st?.summary ? ` — ${st.summary}` : ''}.`,
      'normal',
    )
  }
}

const cmd = process.argv[2]
if (cmd === 'run') {
  const m = readMonitors().find((x) => x.id === process.argv[3])
  if (!m) {
    console.error(`monitor ${process.argv[3]} not found`)
    process.exit(1)
  }
  await runOne(m, Date.now())
} else if (cmd === 'digest') {
  await digest()
} else {
  await tick()
}
