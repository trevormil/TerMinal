#!/usr/bin/env bash
# release — full rebuild of the macOS app + reinstall to /Applications.
#
# Packages (electron-vite build + electron-builder), deep ad-hoc signs (so it
# launches on Apple Silicon), quits the running copy, installs to /Applications,
# and relaunches. This is the "full re-build" flow — run it after changes so the
# installed app is current. (True self-update via electron-updater needs an Apple
# Developer ID signature + notarization; see docs/runbooks/build-and-release.md.)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
DEST="${TERMINAL_APP_DEST:-/Applications/TerMinal.app}"

sync_latest() {
  if [[ "${TERMINAL_RELEASE_SKIP_PULL:-}" == "1" ]]; then
    echo "▸ latest check: skipped (TERMINAL_RELEASE_SKIP_PULL=1)"
    return
  fi

  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "▸ latest check: skipped (not a git checkout)"
    return
  fi

  if ! git remote get-url origin >/dev/null 2>&1; then
    echo "▸ latest check: skipped (no origin remote)"
    return
  fi

  echo "▸ latest check: fetching origin…"
  git fetch --quiet --prune origin

  local default_branch
  default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)"
  if [[ -z "$default_branch" ]]; then
    if git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null; then
      default_branch="main"
    elif git rev-parse --verify --quiet refs/remotes/origin/master >/dev/null; then
      default_branch="master"
    fi
  fi
  if [[ -z "$default_branch" ]]; then
    echo "▸ latest check: skipped (could not detect origin default branch)"
    return
  fi

  local current_branch
  current_branch="$(git branch --show-current)"
  if [[ "$current_branch" != "$default_branch" ]]; then
    echo "▸ latest check: on $current_branch, not $default_branch; building current checkout"
    return
  fi

  if [[ -n "$(git status --porcelain)" ]]; then
    echo "▸ latest check: local changes present; building current checkout"
    return
  fi

  local local_sha remote_ref remote_sha base_sha
  remote_ref="refs/remotes/origin/$default_branch"
  local_sha="$(git rev-parse HEAD)"
  remote_sha="$(git rev-parse "$remote_ref")"
  base_sha="$(git merge-base HEAD "$remote_ref")"

  if [[ "$local_sha" == "$remote_sha" ]]; then
    echo "▸ latest check: already at origin/$default_branch"
  elif [[ "$local_sha" == "$base_sha" ]]; then
    echo "▸ latest check: fast-forwarding to origin/$default_branch…"
    git merge --ff-only "$remote_ref"
  else
    echo "▸ latest check: local $default_branch is ahead or diverged; building current checkout"
  fi

  if [[ -f .gitmodules ]]; then
    git submodule update --init --recursive
  fi
}

sync_latest

echo "▸ building…"
# Clear previous distributables first — stale DMGs from older versions (or an
# older product name) would otherwise pollute SHA256SUMS.txt below.
rm -f dist/*.dmg dist/*.blockmap dist/SHA256SUMS.txt
# ---- provenance gate (ticket 93 / security finding F-14) --------------------
#
# TerMinal's "Update now" button runs THIS script against the local checkout.
# Without a gate, anything that can write to the working tree — a compromised
# dependency, a hostile agent run, a stray `git reset` — becomes the next build
# the operator installs and trusts, now with a Developer ID signature on it.
#
# Signing makes this WORSE, not better: an ad-hoc build announced itself with a
# Gatekeeper warning, and a signed one will not.
#
# The honest gate available here is REACHABILITY: refuse to produce a self-update
# build from a commit that is not on origin's default branch. That stops a
# local-only commit, a rewritten history, or an unpushed working tree from being
# released. It does NOT prove authorship — the repo does not use signed tags, so
# `git verify-tag` would pass vacuously and give false assurance. Upgrading to
# real verification means turning on tag/commit signing first.
#
# Only enforced for self-update builds (TERMINAL_SELF_UPDATE=1, set by the app).
# A human at a terminal building a feature branch is doing so deliberately.
if [[ "${TERMINAL_SELF_UPDATE:-}" == "1" ]]; then
  echo "▸ provenance: verifying this commit is published…"
  git fetch --quiet --prune origin || true
  head_sha="$(git rev-parse HEAD)"
  default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || echo main)"
  if [[ -n "$(git status --porcelain)" ]]; then
    echo "release: refusing a self-update build from a DIRTY working tree." >&2
    echo "         Uncommitted changes would be signed and installed as a release." >&2
    exit 1
  fi
  if ! git merge-base --is-ancestor "$head_sha" "refs/remotes/origin/$default_branch" 2>/dev/null; then
    echo "release: refusing a self-update build — HEAD ($(git rev-parse --short HEAD)) is not" >&2
    echo "         reachable from origin/$default_branch. Push and merge it first." >&2
    exit 1
  fi
  echo "  ✓ $(git rev-parse --short HEAD) is on origin/$default_branch"
fi

bun run dist

# electron-builder emits the .app under dist/mac-arm64 (Apple Silicon),
# dist/mac (Intel), or dist/mac-universal — no arch is pinned. Glob for
# whichever the build actually produced (newest first) instead of guessing by
# host arch, which is wrong under Rosetta and misses universal builds.
# Resolved AFTER the build on purpose: a fresh checkout/worktree has no dist/
# yet, and the old pre-build glob made release error out exactly there.
APP="$(ls -dt dist/mac*/TerMinal.app 2>/dev/null | head -n1 || true)"
if [[ -z "$APP" ]]; then
  echo "release: build produced no app under dist/mac*/TerMinal.app" >&2
  exit 1
fi

# Emit SHA-256 checksums for the distributable(s) so a download can be verified
# before the Gatekeeper bypass (the build is unsigned). See docs/setup.md.
echo "▸ checksums…"
if compgen -G "dist/*.dmg" >/dev/null; then
  ( cd dist && shasum -a 256 *.dmg > SHA256SUMS.txt )
  sed 's/^/    /' dist/SHA256SUMS.txt
  echo "  → dist/SHA256SUMS.txt"
else
  echo "  no .dmg produced — skipping checksums"
fi

# ---- signing + notarization (ticket 93) -------------------------------------
#
# Two paths, chosen by whether a Developer ID identity is actually present —
# NOT by a flag someone has to remember. A contributor without the cert still
# gets a working local build; anyone with it gets the real thing.
#
# This matters more than "no Gatekeeper warning": since Electron 42, macOS only
# delivers notifications for a SIGNED app, so an unsigned build silently loses
# the desktop alert channel.
DEV_ID="$(security find-identity -v -p codesigning 2>/dev/null \
  | sed -n 's/.*"\(Developer ID Application: .*\)"/\1/p' | head -n1)"

if [[ -n "$DEV_ID" && "${TERMINAL_UNSIGNED:-}" != "1" ]]; then
  echo "▸ signing as: $DEV_ID"
  # --deep is DELIBERATELY absent. Apple deprecated it and it signs nested code
  # with the OUTER bundle's entitlements, which silently strips the inherit
  # entitlement from helpers and makes the app fail to launch under the hardened
  # runtime. electron-builder already signed every nested binary correctly
  # during `dist`; re-signing only the outer bundle preserves that.
  codesign --force --options runtime --timestamp \
    --entitlements build/entitlements.mac.plist \
    --sign "$DEV_ID" "$APP"
  codesign --verify --strict --verbose=2 "$APP"

  echo "▸ notarizing (this takes a few minutes)…"
  # Notarize the DMG: stapling it covers both the disk image and the app inside,
  # so a downloader gets a ticket even with no network on first launch.
  DMG="$(ls -t dist/*.dmg 2>/dev/null | head -n1 || true)"
  if [[ -z "$DMG" ]]; then
    echo "release: no .dmg to notarize" >&2
    exit 1
  fi
  # Credentials: the App Store Connect API key (same one the iOS TestFlight
  # flow uses). Read from ios/.testflight.env so there is ONE place to rotate
  # them, and never printed.
  if [[ -f ios/.testflight.env ]]; then
    set -a; . ios/.testflight.env; set +a
  fi
  ASC_KEY_PATH="${ASC_KEY_PATH:-$HOME/.appstoreconnect/private_keys/AuthKey_${ASC_KEY_ID:-}.p8}"
  if [[ -z "${ASC_KEY_ID:-}" || -z "${ASC_ISSUER_ID:-}" || ! -f "$ASC_KEY_PATH" ]]; then
    echo "release: signed the app but cannot notarize — missing App Store Connect key." >&2
    echo "         Need ASC_KEY_ID + ASC_ISSUER_ID (ios/.testflight.env) and $ASC_KEY_PATH" >&2
    exit 1
  fi
  xcrun notarytool submit "$DMG" \
    --key "$ASC_KEY_PATH" --key-id "$ASC_KEY_ID" --issuer "$ASC_ISSUER_ID" \
    --wait --timeout 30m
  # Staple BOTH: the .app is what gets installed to /Applications, the .dmg is
  # what gets published. Stapling only the dmg leaves the installed copy needing
  # a network round-trip to Apple on first launch.
  xcrun stapler staple "$APP"
  xcrun stapler staple "$DMG"
  # The real proof. `codesign --verify` passes on an un-notarized build too;
  # only Gatekeeper assessment tells you a downloader will be let through.
  spctl --assess --type execute --verbose=4 "$APP"
  echo "▸ notarized + stapled ✓"
else
  if [[ "${TERMINAL_UNSIGNED:-}" == "1" ]]; then
    echo "▸ ad-hoc signing (TERMINAL_UNSIGNED=1)…"
  else
    echo "▸ ad-hoc signing — no Developer ID identity in the keychain."
    echo "  NOTE: macOS will NOT deliver notifications from this build (Electron 42+)."
  fi
  codesign --force --deep --sign - "$APP"
  codesign --verify --deep --strict "$APP"
fi

echo "▸ installing → ${DEST}…"
# Stage the new build alongside the old one FIRST, so the multi-second cp -R
# never runs with no working app in place — if it fails or is interrupted,
# $DEST is untouched. The actual swap below is then just two directory
# renames (fast, effectively atomic), not the whole copy.
STAGE="${DEST}.new"
rm -rf "$STAGE"
cp -R "$APP" "$STAGE"
xattr -cr "$STAGE"

if [[ "${TERMINAL_RELEASE_NO_RELAUNCH:-}" != "1" ]]; then
  pkill -f "$DEST/Contents/MacOS" 2>/dev/null || true
  sleep 1
fi
OLD="${DEST}.old"
rm -rf "$OLD"
[[ -d "$DEST" ]] && mv "$DEST" "$OLD"
mv "$STAGE" "$DEST"
rm -rf "$OLD"

if [[ "${TERMINAL_RELEASE_NO_RELAUNCH:-}" == "1" ]]; then
  # The running copy keeps its in-memory code; the new build takes effect on
  # the next launch. Lets a release land mid-session without killing it.
  echo "▸ installed — restart TerMinal when ready (TERMINAL_RELEASE_NO_RELAUNCH=1)"
else
  echo "▸ launching…"
  open "$DEST"
fi
echo "✓ released → $DEST"
