node_modules
out
dist
*.log
.DS_Store
# Per-repo TerMinal runtime state (notes, widgets) — local to each checkout.
# Anchored to the root: templates/project-template/.TerMinal is real template
# content and must stay tracked.
/.TerMinal/
.status.md

# Workflow state — tickets, sessions, reviews, checks, reports — lives in this
# project's sidecar outside the repo (ADR-0020), never here. These entries stop
# an older checkout or a stray helper re-committing any of it. Anchored to the
# root so templates/project-template/ content stays tracked.
/backlog/
/sessions/
/reports/
/.reviews/
/.checks/

# CodeGraph local index — per-repo, user-managed; never committed (keeps builds
# from stamping -dirty). Indexing is the operator's decision (see CLAUDE.md).
.codegraph/

# Playwright (tier 1 UX suite) run output — traces, screenshots, the canary stamp.
/test-results/
/playwright-report/

# Where the legacy sweep banks retired per-repo seeds (ADR-0023). Local-only —
# and it must not show as untracked, or bin/release treats the checkout as
# dirty and refuses to fast-forward to origin/main.
.claude/pre-tm-backup/
